+// Claude (08/11): PS2X_LOG_FPS: quanto cada caminho do Present segura a janela (0 = recente, 1 = cópia imediata)
+static void otxMedePresent(int caminho, std::chrono::steady_clock::time_point t0)
+{
+    static const bool log = std::getenv("PS2X_LOG_FPS") != nullptr;
+    if (!log)
