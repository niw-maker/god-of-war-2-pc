+// Claude (05/11): um eixo de um sprite como o GS o desenha: cobre os pixels p com a <= p < b (coordenadas em 12.4, então
+// y1 = 895,4375 ainda desenha a linha 895) e amostra a textura no próprio p, sem meio pixel. Os dois renderizadores
+// amostram em p + 0,5 (u = c0 + (c1 - c0) * (p - p0 + 0,5) / span), então c0 e c1 já vêm compensados. Antes: última linha
+// cortada e sprites que reduzem a textura lendo além dela (o brilho do God of War II lia a linha 448, que já é o Z: a
+// faixa verde/roxa na parte de baixo da tela). PS2X_GS_SPRITE_ANTIGO=1 volta ao cálculo anterior.
+struct OtxEixoSprite
+{
+    int p0 = 0, span = 1;
+    bool vazio = false, troca = false;
+    double a = 0.0, b = 0.0;
+
+    static bool antigo()
+    {
+        static const bool v = [] { const char *e = std::getenv("PS2X_GS_SPRITE_ANTIGO"); return e && e[0] == '1'; }();
+        return v;
+    }
+
+    // pa, pb: posições dos vértices; of: XYOFFSET em 1/16 de pixel
+    OtxEixoSprite(float pa, float pb, uint32_t of)
+    {
+        if (antigo())
+        {
+            int i0 = static_cast<int>(pa) - static_cast<int>(of >> 4), i1 = static_cast<int>(pb) - static_cast<int>(of >> 4);
+            troca = i0 > i1;
+            if (troca)
+                std::swap(i0, i1);
+            p0 = i0;
+            span = i1 - i0 > 1 ? i1 - i0 : 1;
+            return;
+        }
+        a = static_cast<double>(pa) - static_cast<double>(of) / 16.0;
+        b = static_cast<double>(pb) - static_cast<double>(of) / 16.0;
+        troca = a > b;
+        if (troca)
+            std::swap(a, b);
+        p0 = static_cast<int>(std::ceil(a));
+        span = static_cast<int>(std::ceil(b)) - p0;
+        vazio = span <= 0;
+    }
+
+    // ca, cb: U ou V dos vértices, em texels (na ordem dos vértices); fst: vieram do registrador UV
+    void coord(float ca, float cb, bool fst, float &c0, float &c1) const
+    {
+        if (antigo())
+        {
+            c0 = fst ? std::floor(ca) : ca;
+            c1 = fst ? std::floor(cb) : cb;
+            if (troca)
+                std::swap(c0, c1);
+            return;
+        }
+        if (troca)
+            std::swap(ca, cb);
+        const double r = (static_cast<double>(cb) - static_cast<double>(ca)) / (b - a);
+        const double d0 = static_cast<double>(ca) + r * (static_cast<double>(p0) - 0.5 - a);
+        c0 = static_cast<float>(d0);
+        c1 = static_cast<float>(d0 + r * static_cast<double>(span));
+    }
+};
