+        return (e && e[0] == '1') || (f && f[0] == '1' && v && v[0] == '1');
+    }();
+    return l;
+}
+bool otxProfundidadePega(std::vector<uint32_t> &destino, uint64_t &gen)
+{
+    std::lock_guard<std::mutex> lk(g_profMtx);
