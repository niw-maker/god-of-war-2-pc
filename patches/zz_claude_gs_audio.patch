+    // procura, em blocos de 4 qwords, uma matriz câmera x projeção do cenário: colunas 0 e 1 com o comprimento do foco
+    // (P00 e |P11|), coluna 3 unitária (o w do recorte é -z da vista); devolve a câmera->mundo derivada (16 floats)
+    bool otxAchaCameraVu(const uint8_t *vu, const OtxCamVuPedido &p, float *camSaida)
+    {
+        const float fx = p.proj[0], fy = p.proj[5];
+        if (!(std::fabs(fx) > 0.1f && std::fabs(fy) > 0.1f))
+            return false;
+        float melhorDist = 150.0f, menorVista = 1e30f;
+        bool achou = false;
+        int nAssin = 0;
+        for (int q = 0; q + 4 <= 1024; ++q)
+        {
+            float M[16];
+            std::memcpy(M, vu + q * 16, sizeof M);
+            for (int t = 0; t < 2; ++t)
+            {
+                float A[16];
+                for (int i = 0; i < 4; ++i)
+                    for (int j = 0; j < 4; ++j)
+                        A[i * 4 + j] = t ? M[j * 4 + i] : M[i * 4 + j];
+                auto col = [&](int j) { return std::sqrt(A[j] * A[j] + A[4 + j] * A[4 + j] + A[8 + j] * A[8 + j]); };
+                const float n0 = col(0), n1 = col(1), n3 = col(3);
+                if (!(std::isfinite(n0) && std::fabs(n0 - std::fabs(fx)) < 0.02f * std::fabs(fx) && std::fabs(n1 - std::fabs(fy)) < 0.02f * std::fabs(fy) &&
+                      std::fabs(n3 - 1.0f) < 0.02f))
+                    continue;
+                ++nAssin;
+                // V (mundo->vista, vetor-linha): colunas 0 e 1 sem o foco; coluna 2 = -coluna 3 (w = -z)
+                double V[16];
+                for (int i = 0; i < 4; ++i)
+                {
+                    V[i * 4 + 0] = A[i * 4 + 0] / fx;
+                    V[i * 4 + 1] = A[i * 4 + 1] / fy;
+                    V[i * 4 + 2] = -A[i * 4 + 3];
+                    V[i * 4 + 3] = i == 3 ? 1.0 : 0.0;
