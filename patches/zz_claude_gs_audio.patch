+    // profundidade (1 = longe) e vetores de movimento zerados, prontos para leitura nos shaders do FSR
+    bool criaAuxiliares(uint32_t w, uint32_t h)
+    {
+        destroiAuxiliares();
+        if (!criaImagem(e.ciProf, e.prof, e.profMem, VK_FORMAT_R32_SFLOAT, w, h) ||
+            !criaImagem(e.ciMv, e.mv, e.mvMem, VK_FORMAT_R32G32_SFLOAT, w, h))
+            return false;
+        comandoAvulso([&](VkCommandBuffer c)
+                      {
+            VkImageMemoryBarrier b[2]{};
+            for (int i = 0; i < 2; ++i)
+            {
+                b[i].sType = VK_STRUCTURE_TYPE_IMAGE_MEMORY_BARRIER;
+                b[i].image = i ? e.mv : e.prof;
+                b[i].subresourceRange = {VK_IMAGE_ASPECT_COLOR_BIT, 0, 1, 0, 1};
+                b[i].oldLayout = VK_IMAGE_LAYOUT_UNDEFINED;
+                b[i].newLayout = VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL;
+                b[i].srcQueueFamilyIndex = b[i].dstQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED;
+                b[i].dstAccessMask = VK_ACCESS_TRANSFER_WRITE_BIT;
+            }
+            vkCmdPipelineBarrier(c, VK_PIPELINE_STAGE_TOP_OF_PIPE_BIT, VK_PIPELINE_STAGE_TRANSFER_BIT, 0, 0, nullptr, 0, nullptr, 2, b);
+            const VkImageSubresourceRange r{VK_IMAGE_ASPECT_COLOR_BIT, 0, 1, 0, 1};
+            VkClearColorValue um{};
+            um.float32[0] = 1.0f;
+            VkClearColorValue zero{};
+            vkCmdClearColorImage(c, e.prof, VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL, &um, 1, &r);
+            vkCmdClearColorImage(c, e.mv, VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL, &zero, 1, &r);
+            for (int i = 0; i < 2; ++i)
+            {
+                b[i].oldLayout = VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL;
+                b[i].newLayout = VK_IMAGE_LAYOUT_SHADER_READ_ONLY_OPTIMAL;
+                b[i].srcAccessMask = VK_ACCESS_TRANSFER_WRITE_BIT;
+                b[i].dstAccessMask = VK_ACCESS_SHADER_READ_BIT;
+            }
+            vkCmdPipelineBarrier(c, VK_PIPELINE_STAGE_TRANSFER_BIT, VK_PIPELINE_STAGE_COMPUTE_SHADER_BIT, 0, 0, nullptr, 0, nullptr, 2, b); });
+        return true;
+    }
