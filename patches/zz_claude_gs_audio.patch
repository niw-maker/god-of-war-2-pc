+        b[1].newLayout = VK_IMAGE_LAYOUT_PRESENT_SRC_KHR;
+        b[1].srcAccessMask = VK_ACCESS_TRANSFER_WRITE_BIT;
+        b[1].dstAccessMask = 0;
+        b[0].srcQueueFamilyIndex = e.familia;
+        b[0].dstQueueFamilyIndex = VK_QUEUE_FAMILY_EXTERNAL;
