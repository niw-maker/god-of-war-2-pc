+// Claude (08/11/2026): porta de controle para testes automáticos (só com PS2X_CONTROLE=<porta TCP>, e só em 127.0.0.1).
+// Uma linha por comando, uma linha de resposta ("ok ..." ou "erro ..."):
+//   ping | estado | le <end hex> <n> | escreve <end hex> <bytes hex> | despeja <arquivo> (os 32 MB da RAM)
+//   botao <BOTOES[+...]> <segundos> | foto <arquivo> | sai
+// Os botões usam os nomes do PS2X_ROTEIRO (CROSS, START, LUP...). A foto é tirada pela thread da janela no quadro seguinte.
+#include "otx_controle_porta.h"
+
+#if defined(_WIN32)
+#define WIN32_LEAN_AND_MEAN
+#define NOMINMAX
+#include <winsock2.h>
+#include <ws2tcpip.h>
+#endif
+
+#include <atomic>
+#include <chrono>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <mutex>
+#include <sstream>
+#include <string>
+#include <thread>
+#include <vector>
+
+bool otxProfundidadePega(std::vector<uint32_t> &destino, uint64_t &gen); // gs_thread_backend.cpp
+
+namespace
+{
+    uint8_t *g_rdram = nullptr;
+    constexpr uint32_t kRam = 32u * 1024u * 1024u;
+
+    std::mutex g_mtx;
+    struct Toque
+    {
+        std::chrono::steady_clock::time_point ate;
+        uint16_t mask;
+        uint8_t eixos;
+    };
+    std::vector<Toque> g_toques;
+    std::string g_fotoPedida;
+    bool g_fotoFeita = false;
+    std::atomic<bool> g_sair{false};
+    std::atomic<double> g_fpsJogo{0.0}, g_fpsGerados{0.0};
+    std::atomic<uint64_t> g_quadros{0};
+
+    bool botoes(const std::string &s, uint16_t &mask, uint8_t &eixos)
+    {
+        static const std::pair<const char *, uint16_t> nomes[] = {
+            {"SELECT", 0x0001}, {"L3", 0x0002}, {"R3", 0x0004}, {"START", 0x0008}, {"UP", 0x0010}, {"RIGHT", 0x0020},
+            {"DOWN", 0x0040}, {"LEFT", 0x0080}, {"L2", 0x0100}, {"R2", 0x0200}, {"L1", 0x0400}, {"R1", 0x0800},
+            {"TRIANGLE", 0x1000}, {"CIRCLE", 0x2000}, {"CROSS", 0x4000}, {"SQUARE", 0x8000}};
+        static const std::pair<const char *, uint8_t> eixosNomes[] = {
+            {"LUP", 1}, {"LDOWN", 2}, {"LLEFT", 4}, {"LRIGHT", 8}, {"RUP", 16}, {"RDOWN", 32}, {"RLEFT", 64}, {"RRIGHT", 128}};
+        mask = 0;
+        eixos = 0;
+        size_t k = 0;
+        while (k <= s.size())
+        {
+            size_t m = s.find('+', k);
+            if (m == std::string::npos)
+                m = s.size();
+            const std::string nome = s.substr(k, m - k);
+            bool achou = false;
+            for (const auto &n : nomes)
+                if (nome == n.first) { mask |= n.second; achou = true; }
+            for (const auto &e : eixosNomes)
+                if (nome == e.first) { eixos |= e.second; achou = true; }
+            if (!achou)
+                return false;
+            k = m + 1;
+        }
+        return mask || eixos;
+    }
+
+    std::string executa(const std::string &linha)
+    {
+        std::istringstream in(linha);
+        std::string cmd;
+        in >> cmd;
+        if (cmd == "ping")
+            return "ok pong";
+        if (cmd == "estado")
+        {
+            char b[160];
+            std::snprintf(b, sizeof b, "ok fps=%.1f gerados=%.1f quadros=%llu", g_fpsJogo.load(), g_fpsGerados.load(),
+                          static_cast<unsigned long long>(g_quadros.load()));
+            return b;
+        }
+        if (cmd == "le" || cmd == "escreve")
+        {
+            std::string sEnd;
+            in >> sEnd;
+            const uint32_t end = static_cast<uint32_t>(std::strtoul(sEnd.c_str(), nullptr, 16)) & 0x1FFFFFFu;
+            if (!g_rdram)
+                return "erro sem memória";
+            if (cmd == "le")
+            {
+                uint32_t n = 0;
+                in >> n;
+                if (n == 0 || n > 4096 || end + n > kRam)
+                    return "erro tamanho";
+                std::string r = "ok ";
+                char h[3];
+                for (uint32_t i = 0; i < n; ++i)
+                {
+                    std::snprintf(h, sizeof h, "%02x", g_rdram[end + i]);
+                    r += h;
+                }
+                return r;
+            }
+            std::string hex;
+            in >> hex;
+            if (hex.empty() || (hex.size() & 1u) || end + hex.size() / 2 > kRam)
+                return "erro dados";
+            for (size_t i = 0; i < hex.size() / 2; ++i)
+                g_rdram[end + i] = static_cast<uint8_t>(std::strtoul(hex.substr(i * 2, 2).c_str(), nullptr, 16));
+            return "ok";
+        }
+        if (cmd == "despeja")
+        {
+            std::string arq;
+            std::getline(in, arq);
+            arq.erase(0, arq.find_first_not_of(' '));
+            if (!g_rdram || arq.empty())
+                return "erro arquivo";
+            FILE *f = std::fopen(arq.c_str(), "wb");
+            if (!f)
+                return "erro não abriu o arquivo";
+            std::fwrite(g_rdram, 1, kRam, f);
+            std::fclose(f);
+            return "ok";
+        }
+        if (cmd == "botao")
+        {
+            std::string nomes;
+            double seg = 0.15;
+            in >> nomes >> seg;
+            uint16_t mask;
+            uint8_t eixos;
+            if (!botoes(nomes, mask, eixos))
+                return "erro botão desconhecido";
+            std::lock_guard<std::mutex> lk(g_mtx);
+            g_toques.push_back({std::chrono::steady_clock::now() + std::chrono::milliseconds(static_cast<int>(seg * 1000.0)), mask, eixos});
+            return "ok";
+        }
+        if (cmd == "foto")
+        {
+            std::string arq;
+            std::getline(in, arq);
+            arq.erase(0, arq.find_first_not_of(' '));
+            if (arq.empty())
+                return "erro arquivo";
+            {
+                std::lock_guard<std::mutex> lk(g_mtx);
+                g_fotoPedida = arq;
+                g_fotoFeita = false;
+            }
+            for (int i = 0; i < 300; ++i)
+            {
+                std::this_thread::sleep_for(std::chrono::milliseconds(10));
+                std::lock_guard<std::mutex> lk(g_mtx);
+                if (g_fotoFeita)
+                    return "ok";
+            }
+            return "erro a janela não tirou a foto";
+        }
+        if (cmd == "profundidade")
+        {
+            std::string arq;
+            std::getline(in, arq);
+            arq.erase(0, arq.find_first_not_of(' '));
+            std::vector<uint32_t> z;
+            uint64_t gen = ~0ull;
+            if (!otxProfundidadePega(z, gen) || z.empty())
+                return "erro sem profundidade (PS2X_PROFUNDIDADE=1)";
+            FILE *f = std::fopen(arq.c_str(), "wb");
+            if (!f)
+                return "erro não abriu o arquivo";
+            std::fwrite(z.data(), 4, z.size(), f);
+            std::fclose(f);
+            return "ok";
+        }
+        if (cmd == "sai")
+        {
+            g_sair = true;
+            return "ok";
+        }
+        return "erro comando desconhecido";
+    }
+
+#if defined(_WIN32)
+    void servidor(int porta)
+    {
+        WSADATA w;
+        if (WSAStartup(MAKEWORD(2, 2), &w) != 0)
+            return;
+        SOCKET s = socket(AF_INET, SOCK_STREAM, IPPROTO_TCP);
+        sockaddr_in a{};
+        a.sin_family = AF_INET;
+        a.sin_port = htons(static_cast<u_short>(porta));
+        a.sin_addr.s_addr = htonl(INADDR_LOOPBACK); // só o próprio PC
+        if (s == INVALID_SOCKET || bind(s, reinterpret_cast<sockaddr *>(&a), sizeof a) != 0 || listen(s, 2) != 0)
+        {
+            std::fprintf(stderr, "[controle] a porta %d não abriu\n", porta);
+            return;
+        }
+        std::fprintf(stderr, "[controle] porta de controle em 127.0.0.1:%d\n", porta);
+        for (;;)
+        {
+            SOCKET c = accept(s, nullptr, nullptr);
+            if (c == INVALID_SOCKET)
+                continue;
+            std::string buf;
+            char tmp[4096];
+            for (;;)
+            {
+                const int n = recv(c, tmp, sizeof tmp, 0);
+                if (n <= 0)
+                    break;
+                buf.append(tmp, tmp + n);
+                size_t p;
+                while ((p = buf.find('\n')) != std::string::npos)
+                {
+                    std::string linha = buf.substr(0, p);
+                    buf.erase(0, p + 1);
+                    if (!linha.empty() && linha.back() == '\r')
+                        linha.pop_back();
+                    const std::string r = executa(linha) + "\n";
+                    send(c, r.data(), static_cast<int>(r.size()), 0);
+                }
+            }
+            closesocket(c);
+        }
+    }
+#endif
+}
+
+void otxControleInicia(uint8_t *rdram)
+{
+    g_rdram = rdram;
+    const char *e = std::getenv("PS2X_CONTROLE");
+    if (!(e && *e))
+        return;
+    const int porta = std::atoi(e);
+#if defined(_WIN32)
+    if (porta > 0)
+        std::thread(servidor, porta).detach();
+#endif
+}
+
+void otxControleToque(uint16_t &soltos, uint8_t &eixos)
+{
+    soltos = 0;
+    eixos = 0;
+    std::lock_guard<std::mutex> lk(g_mtx);
+    const auto agora = std::chrono::steady_clock::now();
+    for (size_t i = 0; i < g_toques.size();)
+    {
+        if (g_toques[i].ate <= agora)
+        {
+            g_toques.erase(g_toques.begin() + static_cast<std::ptrdiff_t>(i));
+            continue;
+        }
+        soltos |= g_toques[i].mask;
+        eixos |= g_toques[i].eixos;
+        ++i;
+    }
+}
+
+bool otxControleFotoPedida(std::string &arquivo)
+{
+    std::lock_guard<std::mutex> lk(g_mtx);
+    if (g_fotoPedida.empty())
+        return false;
+    arquivo = g_fotoPedida;
+    return true;
+}
+
+void otxControleFotoFeita()
+{
+    std::lock_guard<std::mutex> lk(g_mtx);
+    g_fotoPedida.clear();
+    g_fotoFeita = true;
+}
+
+void otxControleMedidas(double fpsJogo, double fpsGerados)
+{
+    if (fpsJogo >= 0.0)
+        g_fpsJogo = fpsJogo;
+    if (fpsGerados >= 0.0)
+        g_fpsGerados = fpsGerados;
+}
+
+void otxControleQuadro()
+{
+    ++g_quadros;
+}
+
+bool otxControleSair()
+{
+    return g_sair.load();
+}
