+        bl.srcSubresource = bl.dstSubresource = {VK_IMAGE_ASPECT_COLOR_BIT, 0, 0, 1};
+        bl.srcOffsets[1] = {w, h, 1};
+        bl.dstOffsets[1] = {static_cast<int32_t>(e.tamTroca.width), static_cast<int32_t>(e.tamTroca.height), 1};
+        vkCmdBlitImage(c, e.comp, VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL, e.imagensTroca[idx], VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL, 1,
+                       &bl, VK_FILTER_LINEAR);
