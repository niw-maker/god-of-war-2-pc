+#pragma once
+// Claude (08/11/2026): apresentação em Vulkan com a imagem do OpenGL (PS2X_VULKAN=1); ver otx_vulkan.cpp
+namespace otx_vk
+{
+    // dados do quadro para a geração de quadros do FSR 3.1 (PS2X_FSR_FG=1)
+    struct Quadro
+    {
+        bool novo = true;               // imagem nova do jogo (quadros repetidos não vão para o FSR)
+        float rx = 0, ry = 0, rw = 0, rh = 0; // área da janela onde o jogo é desenhado (sem as tarjas)
+        bool temCamera = false;
+        float pos[3]{}, cima[3]{}, direita[3]{}, frente[3]{};
+        float perto = 10.0f, longe = 10000.0f, fovY = 0.75f;
+        bool corte = false;             // a câmera pulou (troca de cena): o FSR recomeça
+        bool semGeracao = false;        // não gerar quadros agora (vídeos: o filme passa 1:1, sem artefatos)
+        // profundidade do FSR (0 = perto, 1 = longe) e vetores de movimento (pixels da janela, do quadro atual para o
+        // anterior), em pw x ph; são ampliados para a área do jogo. Nulos: movimento zerado.
+        const float *prof = nullptr;
+        const float *mv = nullptr;
+        int pw = 0, ph = 0;
+    };
+    // calcula a profundidade do FSR e os vetores de movimento da câmera a partir do Z24 do GS (w x h) e das câmeras
+    // (16 floats câmera->mundo + 16 da projeção) do quadro atual e do anterior; esc*: pixels do jogo -> pixels da janela
+    bool calculaMovimento(const unsigned int *z, int w, int h, const float *camAtual, const float *camAnt, float escX, float escY,
+                          float *prof, float *mv, float &perto, float &longe, float &fovY);
+    // hwnd: a janela do jogo (GetWindowHandle da raylib), com o contexto GL atual nesta thread
+    bool inicia(void *hwnd);
+    bool ativo();
+    // a geração de quadros do FSR 3.1 está ligada (então só quadros novos devem ser apresentados)
+    bool fsrFg();
+    // copia o framebuffer padrão do GL (w x h) e mostra pelo Vulkan; o GL não deve mais trocar os buffers da janela
+    bool apresenta(int w, int h, const Quadro *q = nullptr);
+    // quadros mostrados por segundo pelo swapchain do FSR (reais + gerados); -1 sem o FSR
+    double quadrosMostrados();
+    // quadros reais (do jogo) entregues por segundo ao swapchain do FSR; -1 sem o FSR
+    double quadrosReais();
+}
