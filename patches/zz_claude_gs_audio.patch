index 0000000..a706d2d
--- /dev/null
+++ b/ps2xRuntime/src/lib/otx_vulkan.cpp
@@ -0,0 +1,1478 @@
+// Claude (08/11/2026): apresentação em Vulkan (PS2X_VULKAN=1). O jogo continua desenhando em OpenGL; a imagem final vai para uma
+// imagem do Vulkan pela memória da GPU (GL_EXT_memory_object_win32 / VK_KHR_external_memory_win32, com semáforos
+// compartilhados) e o Vulkan a mostra na janela. É a base para o FSR 3.1 (geração de quadros e ampliação), que só existe
+// para DirectX 12 e Vulkan.
+#include "otx_vulkan.h"
+
+#if defined(_WIN32) && defined(PS2X_TEM_VULKAN)
+#define WIN32_LEAN_AND_MEAN
+#define NOMINMAX
+#include <windows.h>
+#define VK_USE_PLATFORM_WIN32_KHR
+#include <vulkan/vulkan.h>
+
+#include <algorithm>
+#include <cmath>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <vector>
+
+#if defined(PS2X_TEM_FFX)
+// FidelityFX SDK 2.4 (FSR 3.1): só os cabeçalhos; as DLLs assinadas da AMD são carregadas na hora (ao lado do .exe)
+#ifndef _WINDOWS
+#define _WINDOWS
+#endif
+#include "api/include/ffx_api.h"
+#include "api/include/ffx_api_loader.h"
+#include "framegeneration/include/ffx_framegeneration.h"
+#include "framegeneration/include/vk/ffx_api_framegeneration_vk.h"
+#endif
+
+namespace
+{
+    // ---- OpenGL (só o necessário, sem cabeçalhos do GL) ----
+    typedef unsigned int GLuint;
+    typedef int GLint;
+    typedef unsigned int GLenum;
+    typedef int GLsizei;
+    typedef unsigned long long GLuint64;
+    typedef unsigned char GLubyte;
+    typedef void(__stdcall *PFN_glCreateMemoryObjectsEXT)(GLsizei, GLuint *);
+    typedef void(__stdcall *PFN_glMemoryObjectParameterivEXT)(GLuint, GLenum, const GLint *);
+    typedef void(__stdcall *PFN_glImportMemoryWin32HandleEXT)(GLuint, GLuint64, GLenum, void *);
+    typedef void(__stdcall *PFN_glTexStorageMem2DEXT)(GLenum, GLsizei, GLenum, GLsizei, GLsizei, GLuint, GLuint64);
+    typedef void(__stdcall *PFN_glGenSemaphoresEXT)(GLsizei, GLuint *);
+    typedef void(__stdcall *PFN_glImportSemaphoreWin32HandleEXT)(GLuint, GLenum, void *);
+    typedef void(__stdcall *PFN_glSignalSemaphoreEXT)(GLuint, GLuint, const GLuint *, GLuint, const GLuint *, const GLenum *);
+    typedef void(__stdcall *PFN_glWaitSemaphoreEXT)(GLuint, GLuint, const GLuint *, GLuint, const GLuint *, const GLenum *);
+    typedef void(__stdcall *PFN_glGetUnsignedBytevEXT)(GLenum, GLubyte *);
+    typedef void(__stdcall *PFN_glGetUnsignedBytei_vEXT)(GLenum, GLuint, GLubyte *);
+    typedef void(__stdcall *PFN_glGenTextures)(GLsizei, GLuint *);
+    typedef void(__stdcall *PFN_glDeleteTextures)(GLsizei, const GLuint *);
+    typedef void(__stdcall *PFN_glBindTexture)(GLenum, GLuint);
+    typedef void(__stdcall *PFN_glTexParameteri)(GLenum, GLenum, GLint);
+    typedef void(__stdcall *PFN_glGenFramebuffers)(GLsizei, GLuint *);
+    typedef void(__stdcall *PFN_glDeleteFramebuffers)(GLsizei, const GLuint *);
+    typedef void(__stdcall *PFN_glBindFramebuffer)(GLenum, GLuint);
+    typedef void(__stdcall *PFN_glFramebufferTexture2D)(GLenum, GLenum, GLenum, GLuint, GLint);
+    typedef void(__stdcall *PFN_glBlitFramebuffer)(GLint, GLint, GLint, GLint, GLint, GLint, GLint, GLint, GLuint, GLenum);
+    typedef void(__stdcall *PFN_glFlush)();
+    typedef void(__stdcall *PFN_glGetIntegerv)(GLenum, GLint *);
+
+    constexpr GLenum GL_TEXTURE_2D = 0x0DE1, GL_RGBA8 = 0x8058, GL_FRAMEBUFFER = 0x8D40, GL_READ_FRAMEBUFFER = 0x8CA8,
+                     GL_DRAW_FRAMEBUFFER = 0x8CA9, GL_COLOR_ATTACHMENT0 = 0x8CE0, GL_COLOR_BUFFER_BIT = 0x4000,
+                     GL_LINEAR = 0x2601, GL_NEAREST = 0x2600, GL_TEXTURE_TILING_EXT = 0x9580, GL_OPTIMAL_TILING_EXT = 0x9584,
+                     GL_HANDLE_TYPE_OPAQUE_WIN32_EXT = 0x9587, GL_DEDICATED_MEMORY_OBJECT_EXT = 0x9581,
+                     GL_LAYOUT_TRANSFER_SRC_EXT = 0x9592, GL_LAYOUT_COLOR_ATTACHMENT_EXT = 0x958E,
+                     GL_DEVICE_UUID_EXT = 0x9597, GL_NUM_DEVICE_UUIDS_EXT = 0x9596, GL_DRAW_FRAMEBUFFER_BINDING = 0x8CA6,
+                     GL_READ_FRAMEBUFFER_BINDING = 0x8CAA;
+
+    struct Gl
+    {
+        PFN_glCreateMemoryObjectsEXT createMemoryObjects;
+        PFN_glMemoryObjectParameterivEXT memoryObjectParameteriv;
+        PFN_glImportMemoryWin32HandleEXT importMemoryWin32Handle;
+        PFN_glTexStorageMem2DEXT texStorageMem2D;
+        PFN_glGenSemaphoresEXT genSemaphores;
+        PFN_glImportSemaphoreWin32HandleEXT importSemaphoreWin32Handle;
+        PFN_glSignalSemaphoreEXT signalSemaphore;
+        PFN_glWaitSemaphoreEXT waitSemaphore;
+        PFN_glGetUnsignedBytevEXT getUnsignedBytev;
+        PFN_glGetUnsignedBytei_vEXT getUnsignedBytei_v;
+        PFN_glGenTextures genTextures;
+        PFN_glDeleteTextures deleteTextures;
+        PFN_glBindTexture bindTexture;
+        PFN_glTexParameteri texParameteri;
+        PFN_glGenFramebuffers genFramebuffers;
+        PFN_glDeleteFramebuffers deleteFramebuffers;
+        PFN_glBindFramebuffer bindFramebuffer;
+        PFN_glFramebufferTexture2D framebufferTexture2D;
+        PFN_glBlitFramebuffer blitFramebuffer;
+        PFN_glFlush flush;
+        PFN_glGetIntegerv getIntegerv;
+    } gl{};
+
+    template <typename T>
+    bool carregaGl(T &f, const char *nome)
+    {
+        PROC p = wglGetProcAddress(nome);
+        if (!p || p == reinterpret_cast<PROC>(1) || p == reinterpret_cast<PROC>(2) || p == reinterpret_cast<PROC>(3) ||
+            p == reinterpret_cast<PROC>(-1))
+        {
+            static HMODULE m = LoadLibraryA("opengl32.dll");
+            p = m ? GetProcAddress(m, nome) : nullptr;
+        }
+        f = reinterpret_cast<T>(p);
+        return f != nullptr;
+    }
+
+    // ---- Vulkan ----
+    struct Estado
+    {
+        bool ok = false;
+        HWND janela = nullptr; // janela do jogo (com o contexto GL)
+        HWND filha = nullptr;  // janela-filha onde o Vulkan apresenta (a NVIDIA não aceita swapchain na janela do GL)
+        VkInstance instancia = VK_NULL_HANDLE;
+        VkPhysicalDevice fisico = VK_NULL_HANDLE;
+        VkDevice dispositivo = VK_NULL_HANDLE;
+        uint32_t familia = 0;
+        VkQueue fila = VK_NULL_HANDLE;
+        VkSurfaceKHR superficie = VK_NULL_HANDLE;
+        VkSwapchainKHR troca = VK_NULL_HANDLE;
+        VkFormat formatoTroca = VK_FORMAT_B8G8R8A8_UNORM;
+        VkExtent2D tamTroca{0, 0};
+        std::vector<VkImage> imagensTroca;
+        VkCommandPool pool = VK_NULL_HANDLE;
+        VkCommandBuffer cmd[2]{};
+        VkFence cerca[2]{};
+        VkSemaphore adquirida[2]{}, pronta[2]{};
+        uint32_t quadro = 0;
+        // imagem compartilhada com o GL
+        VkImage comp = VK_NULL_HANDLE;
+        VkDeviceMemory compMem = VK_NULL_HANDLE;
+        uint32_t compW = 0, compH = 0;
+        VkSemaphore glPronto = VK_NULL_HANDLE, vkPronto = VK_NULL_HANDLE;
+        GLuint glTex = 0, glFbo = 0, glMem = 0, glSemGl = 0, glSemVk = 0;
+        bool vkEmVoo = false;
+        PFN_vkGetMemoryWin32HandleKHR getMemHandle = nullptr;
+        PFN_vkGetSemaphoreWin32HandleKHR getSemHandle = nullptr;
+        VkSwapchainCreateInfoKHR ciTroca{};
+        // filas extras para o FSR (a apresentação dele roda em outra thread e não pode dividir a fila do jogo)
+        VkQueue filaApres = VK_NULL_HANDLE, filaAdq = VK_NULL_HANDLE, filaAsync = VK_NULL_HANDLE;
+        uint32_t familiaAsync = 0;
+#if defined(PS2X_TEM_FFX)
+        bool fg = false; // geração de quadros do FSR 3.1 ligada
+        HMODULE ffxDll = nullptr;
+        ffxFunctions ffx{};
+        ffxContext ctxTroca = nullptr, ctxFg = nullptr;
+        PFN_vkAcquireNextImageKHR adquire = nullptr;
+        PFN_vkQueuePresentKHR apresentaFfx = nullptr;
+        PFN_vkGetSwapchainImagesKHR imagensFfx = nullptr;
+        PFN_vkDestroySwapchainFFXAPI destroiTrocaFfx = nullptr;
+        PFN_getLastPresentCountFFXAPI contaApres = nullptr;
+        // profundidade e vetores de movimento (por enquanto vazios: o FSR usa o próprio fluxo óptico)
+        VkImage prof = VK_NULL_HANDLE, mv = VK_NULL_HANDLE;
+        VkDeviceMemory profMem = VK_NULL_HANDLE, mvMem = VK_NULL_HANDLE;
+        VkImageCreateInfo ciProf{}, ciMv{};
+        // origem (tamanho do jogo) e buffers de envio, um por quadro em voo
+        VkImage profSrc = VK_NULL_HANDLE, mvSrc = VK_NULL_HANDLE;
+        VkDeviceMemory profSrcMem = VK_NULL_HANDLE, mvSrcMem = VK_NULL_HANDLE;
+        VkImageCreateInfo ciProfSrc{}, ciMvSrc{};
+        uint32_t srcW = 0, srcH = 0;
+        VkBuffer envio[2]{};
+        VkDeviceMemory envioMem[2]{};
+        uint8_t *envioPtr[2]{};
+        bool ampliaOk = false;
+        uint64_t idQuadro = 0, idAnt = 0;
+        double msAdq = 0, msApres = 0, msCerca = 0, msTotal = 0; // medições (PS2X_LOG_FPS)
+        LARGE_INTEGER tAnt{};
+        uint64_t apresAnt = 0;
+        double tApresAnt = 0.0, mostrados = -1.0, reais = -1.0;
+        uint32_t flagsDebug = 0;
+#endif
+    } e;
+
+    void log(const char *msg) { std::fprintf(stderr, "[vulkan] %s\n", msg); }
+
+    uint32_t tipoMemoria(uint32_t bits, VkMemoryPropertyFlags props)
+    {
+        VkPhysicalDeviceMemoryProperties mp;
+        vkGetPhysicalDeviceMemoryProperties(e.fisico, &mp);
+        for (uint32_t i = 0; i < mp.memoryTypeCount; ++i)
+            if ((bits & (1u << i)) && (mp.memoryTypes[i].propertyFlags & props) == props)
+                return i;
+        return 0;
+    }
+
+    bool criaTroca(uint32_t w, uint32_t h)
+    {
+        vkDeviceWaitIdle(e.dispositivo);
+        VkSurfaceCapabilitiesKHR cap;
+        vkGetPhysicalDeviceSurfaceCapabilitiesKHR(e.fisico, e.superficie, &cap);
+        VkExtent2D t = cap.currentExtent.width != 0xFFFFFFFFu ? cap.currentExtent : VkExtent2D{w, h};
+        if (t.width == 0 || t.height == 0)
+            return false;
+        uint32_t n = 0;
+        vkGetPhysicalDeviceSurfaceFormatsKHR(e.fisico, e.superficie, &n, nullptr);
+        std::vector<VkSurfaceFormatKHR> fmts(n);
+        vkGetPhysicalDeviceSurfaceFormatsKHR(e.fisico, e.superficie, &n, fmts.data());
+        e.formatoTroca = fmts.empty() ? VK_FORMAT_B8G8R8A8_UNORM : fmts[0].format;
+        for (auto &f : fmts)
+            if (f.format == VK_FORMAT_B8G8R8A8_UNORM)
+                e.formatoTroca = f.format;
+        VkSwapchainCreateInfoKHR ci{VK_STRUCTURE_TYPE_SWAPCHAIN_CREATE_INFO_KHR};
+        ci.surface = e.superficie;
+        ci.minImageCount = std::max(cap.minImageCount, 3u);
+        if (cap.maxImageCount)
+            ci.minImageCount = std::min(ci.minImageCount, cap.maxImageCount);
+        ci.imageFormat = e.formatoTroca;
+        ci.imageColorSpace = VK_COLOR_SPACE_SRGB_NONLINEAR_KHR;
+        ci.imageExtent = t;
+        ci.imageArrayLayers = 1;
+        ci.imageUsage = VK_IMAGE_USAGE_TRANSFER_DST_BIT | VK_IMAGE_USAGE_COLOR_ATTACHMENT_BIT;
+        ci.imageSharingMode = VK_SHARING_MODE_EXCLUSIVE;
+        ci.preTransform = cap.currentTransform;
+        ci.compositeAlpha = VK_COMPOSITE_ALPHA_OPAQUE_BIT_KHR;
+        // PS2X_VK_MODO=imediato: sem vsync (telas VRR e medições); mailbox: sem rasgo e sem esperar o vsync
+        ci.presentMode = VK_PRESENT_MODE_FIFO_KHR;
+        {
+            const char *modo = std::getenv("PS2X_VK_MODO");
+            uint32_t nm = 0;
+            vkGetPhysicalDeviceSurfacePresentModesKHR(e.fisico, e.superficie, &nm, nullptr);
+            std::vector<VkPresentModeKHR> modos(nm);
+            vkGetPhysicalDeviceSurfacePresentModesKHR(e.fisico, e.superficie, &nm, modos.data());
+            const VkPresentModeKHR quer = (modo && modo[0] == 'i') ? VK_PRESENT_MODE_IMMEDIATE_KHR
+                                          : (modo && modo[0] == 'm') ? VK_PRESENT_MODE_MAILBOX_KHR
+                                                                     : VK_PRESENT_MODE_FIFO_KHR;
+            if (std::find(modos.begin(), modos.end(), quer) != modos.end())
+                ci.presentMode = quer;
+        }
+        ci.clipped = VK_TRUE;
+        ci.oldSwapchain = e.troca;
+        VkSwapchainKHR nova;
+        if (vkCreateSwapchainKHR(e.dispositivo, &ci, nullptr, &nova) != VK_SUCCESS)
+            return false;
+        if (e.troca)
+            vkDestroySwapchainKHR(e.dispositivo, e.troca, nullptr);
+        e.troca = nova;
+        ci.oldSwapchain = VK_NULL_HANDLE;
+        e.ciTroca = ci;
+        e.tamTroca = t;
+        vkGetSwapchainImagesKHR(e.dispositivo, e.troca, &n, nullptr);
+        e.imagensTroca.resize(n);
+        vkGetSwapchainImagesKHR(e.dispositivo, e.troca, &n, e.imagensTroca.data());
+        return true;
+    }
+
+    void destroiCompartilhada()
+    {
+        if (e.glFbo)
+            gl.deleteFramebuffers(1, &e.glFbo);
+        if (e.glTex)
+            gl.deleteTextures(1, &e.glTex);
+        e.glFbo = e.glTex = 0;
+        if (e.comp)
+            vkDestroyImage(e.dispositivo, e.comp, nullptr);
+        if (e.compMem)
+            vkFreeMemory(e.dispositivo, e.compMem, nullptr);
+        e.comp = VK_NULL_HANDLE;
+        e.compMem = VK_NULL_HANDLE;
+        e.compW = e.compH = 0;
+    }
+
+    bool criaCompartilhada(uint32_t w, uint32_t h)
+    {
+        vkDeviceWaitIdle(e.dispositivo);
+        destroiCompartilhada();
+        VkExternalMemoryImageCreateInfo ext{VK_STRUCTURE_TYPE_EXTERNAL_MEMORY_IMAGE_CREATE_INFO};
+        ext.handleTypes = VK_EXTERNAL_MEMORY_HANDLE_TYPE_OPAQUE_WIN32_BIT;
+        VkImageCreateInfo ci{VK_STRUCTURE_TYPE_IMAGE_CREATE_INFO};
+        ci.pNext = &ext;
+        ci.imageType = VK_IMAGE_TYPE_2D;
+        ci.format = VK_FORMAT_R8G8B8A8_UNORM;
+        ci.extent = {w, h, 1};
+        ci.mipLevels = 1;
+        ci.arrayLayers = 1;
+        ci.samples = VK_SAMPLE_COUNT_1_BIT;
+        ci.tiling = VK_IMAGE_TILING_OPTIMAL;
+        ci.usage = VK_IMAGE_USAGE_TRANSFER_SRC_BIT | VK_IMAGE_USAGE_TRANSFER_DST_BIT | VK_IMAGE_USAGE_COLOR_ATTACHMENT_BIT |
+                   VK_IMAGE_USAGE_SAMPLED_BIT | VK_IMAGE_USAGE_STORAGE_BIT;
+        ci.initialLayout = VK_IMAGE_LAYOUT_UNDEFINED;
+        if (vkCreateImage(e.dispositivo, &ci, nullptr, &e.comp) != VK_SUCCESS)
+            return false;
+        VkMemoryRequirements req;
+        vkGetImageMemoryRequirements(e.dispositivo, e.comp, &req);
+        VkExportMemoryAllocateInfo exp{VK_STRUCTURE_TYPE_EXPORT_MEMORY_ALLOCATE_INFO};
+        exp.handleTypes = VK_EXTERNAL_MEMORY_HANDLE_TYPE_OPAQUE_WIN32_BIT;
+        VkMemoryDedicatedAllocateInfo ded{VK_STRUCTURE_TYPE_MEMORY_DEDICATED_ALLOCATE_INFO};
+        ded.image = e.comp;
+        exp.pNext = &ded;
+        VkMemoryAllocateInfo ai{VK_STRUCTURE_TYPE_MEMORY_ALLOCATE_INFO};
+        ai.pNext = &exp;
+        ai.allocationSize = req.size;
+        ai.memoryTypeIndex = tipoMemoria(req.memoryTypeBits, VK_MEMORY_PROPERTY_DEVICE_LOCAL_BIT);
+        if (vkAllocateMemory(e.dispositivo, &ai, nullptr, &e.compMem) != VK_SUCCESS)
+            return false;
+        vkBindImageMemory(e.dispositivo, e.comp, e.compMem, 0);
+        VkMemoryGetWin32HandleInfoKHR hi{VK_STRUCTURE_TYPE_MEMORY_GET_WIN32_HANDLE_INFO_KHR};
+        hi.memory = e.compMem;
+        hi.handleType = VK_EXTERNAL_MEMORY_HANDLE_TYPE_OPAQUE_WIN32_BIT;
+        HANDLE h_ = nullptr;
+        if (e.getMemHandle(e.dispositivo, &hi, &h_) != VK_SUCCESS)
+            return false;
+        gl.createMemoryObjects(1, &e.glMem);
+        const GLint dedicada = 1;
+        gl.memoryObjectParameteriv(e.glMem, GL_DEDICATED_MEMORY_OBJECT_EXT, &dedicada);
+        gl.importMemoryWin32Handle(e.glMem, req.size, GL_HANDLE_TYPE_OPAQUE_WIN32_EXT, h_);
+        gl.genTextures(1, &e.glTex);
+        gl.bindTexture(GL_TEXTURE_2D, e.glTex);
+        gl.texParameteri(GL_TEXTURE_2D, GL_TEXTURE_TILING_EXT, GL_OPTIMAL_TILING_EXT);
+        gl.texStorageMem2D(GL_TEXTURE_2D, 1, GL_RGBA8, static_cast<GLsizei>(w), static_cast<GLsizei>(h), e.glMem, 0);
+        gl.bindTexture(GL_TEXTURE_2D, 0);
+        GLint fboAnt = 0;
+        gl.getIntegerv(GL_DRAW_FRAMEBUFFER_BINDING, &fboAnt);
+        gl.genFramebuffers(1, &e.glFbo);
+        gl.bindFramebuffer(GL_FRAMEBUFFER, e.glFbo);
+        gl.framebufferTexture2D(GL_FRAMEBUFFER, GL_COLOR_ATTACHMENT0, GL_TEXTURE_2D, e.glTex, 0);
+        gl.bindFramebuffer(GL_FRAMEBUFFER, static_cast<GLuint>(fboAnt));
+        CloseHandle(h_);
+        e.compW = w;
+        e.compH = h;
+        e.vkEmVoo = false;
+        return true;
+    }
+
+    bool criaSemaforoExportado(VkSemaphore &s, GLuint &glS)
+    {
+        VkExportSemaphoreCreateInfo ex{VK_STRUCTURE_TYPE_EXPORT_SEMAPHORE_CREATE_INFO};
+        ex.handleTypes = VK_EXTERNAL_SEMAPHORE_HANDLE_TYPE_OPAQUE_WIN32_BIT;
+        VkSemaphoreCreateInfo ci{VK_STRUCTURE_TYPE_SEMAPHORE_CREATE_INFO};
+        ci.pNext = &ex;
+        if (vkCreateSemaphore(e.dispositivo, &ci, nullptr, &s) != VK_SUCCESS)
+            return false;
+        VkSemaphoreGetWin32HandleInfoKHR hi{VK_STRUCTURE_TYPE_SEMAPHORE_GET_WIN32_HANDLE_INFO_KHR};
+        hi.semaphore = s;
+        hi.handleType = VK_EXTERNAL_SEMAPHORE_HANDLE_TYPE_OPAQUE_WIN32_BIT;
+        HANDLE h = nullptr;
+        if (e.getSemHandle(e.dispositivo, &hi, &h) != VK_SUCCESS)
+            return false;
+        gl.genSemaphores(1, &glS);
+        gl.importSemaphoreWin32Handle(glS, GL_HANDLE_TYPE_OPAQUE_WIN32_EXT, h);
+        CloseHandle(h);
+        return true;
+    }
+
+    // um comando avulso, esperado até o fim (criação de recursos)
+    template <typename F>
+    void comandoAvulso(F &&grava)
+    {
+        VkCommandBufferAllocateInfo cai{VK_STRUCTURE_TYPE_COMMAND_BUFFER_ALLOCATE_INFO};
+        cai.commandPool = e.pool;
+        cai.level = VK_COMMAND_BUFFER_LEVEL_PRIMARY;
+        cai.commandBufferCount = 1;
+        VkCommandBuffer c;
+        vkAllocateCommandBuffers(e.dispositivo, &cai, &c);
+        VkCommandBufferBeginInfo bi{VK_STRUCTURE_TYPE_COMMAND_BUFFER_BEGIN_INFO};
+        bi.flags = VK_COMMAND_BUFFER_USAGE_ONE_TIME_SUBMIT_BIT;
+        vkBeginCommandBuffer(c, &bi);
+        grava(c);
+        vkEndCommandBuffer(c);
+        VkSubmitInfo s{VK_STRUCTURE_TYPE_SUBMIT_INFO};
+        s.commandBufferCount = 1;
+        s.pCommandBuffers = &c;
+        vkQueueSubmit(e.fila, 1, &s, VK_NULL_HANDLE);
+        vkQueueWaitIdle(e.fila);
+        vkFreeCommandBuffers(e.dispositivo, e.pool, 1, &c);
+    }
