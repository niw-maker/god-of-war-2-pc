+    std::memcpy(&pp, ram + 0x2D7BC4u, 4);
+    pc &= 0x1FFFFFFu;
+    pp &= 0x1FFFFFFu;
+    if (pc < 0x100000u || pc >= 0x1FF0000u || pp < 0x100000u || pp >= 0x1FF0000u)
+        return false;
+    std::memcpy(m, ram + pc + 0xD0u, 16 * sizeof(float));
+    std::memcpy(m + 16, ram + pp + 0x40u, 16 * sizeof(float));
+    return true;
+}
+void otxCameraGuarda(const float *cam16, const float *proj16)
+{
+    std::lock_guard<std::mutex> lk(g_camMtx);
+    std::memcpy(g_camPend, cam16, 16 * sizeof(float));
+    std::memcpy(g_camPend + 16, proj16, 16 * sizeof(float));
+    g_camPendTem = true;
+}
+static void otxCameraDaCaptura(uint64_t gen)
+{
+    std::lock_guard<std::mutex> lk(g_camMtx);
+    CamCap &c = g_camCaps[gen & 7u];
+    c.gen = gen;
+    // PS2X_CAMERA=fila: a câmera em vigor na thread do GS (veio pela fila, em ordem com os desenhos deste quadro)
+    static const bool daFila = []
+    {
+        const char *e = std::getenv("PS2X_CAMERA");
+        return e && (std::strcmp(e, "fila") == 0 || std::strcmp(e, "vu") == 0);
+    }();
+    if (daFila)
+    {
+        c.tem = g_camGsTem;
+        std::memcpy(c.m, g_camGs, sizeof c.m);
+        return;
+    }
+    // PS2X_CAMERA=captura: lida da RAM agora (alinhamento em teste); padrão: a do gancho do FINISH
+    static const bool daRam = [] { const char *e = std::getenv("PS2X_CAMERA"); return e && std::strcmp(e, "captura") == 0; }();
+    if (daRam && otxCameraDaRam(c.m))
+    {
+        c.tem = true;
+        return;
+    }
+    c.tem = g_camPendTem;
+    std::memcpy(c.m, g_camPend, sizeof c.m);
+}
+static bool otxCameraDe(uint64_t gen, float *m)
+{
+    std::lock_guard<std::mutex> lk(g_camMtx);
+    const CamCap &c = g_camCaps[gen & 7u];
+    if (c.gen != gen || !c.tem)
+        return false;
+    std::memcpy(m, c.m, sizeof c.m);
+    return true;
+}
