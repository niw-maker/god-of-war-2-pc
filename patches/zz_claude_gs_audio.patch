+    // imagens no tamanho do jogo (profundidade R32F, movimento RG32F) e buffers de envio mapeados
+    bool criaFontes(uint32_t w, uint32_t h)
+    {
+        destroiFontes();
+        if (!criaImagem(e.ciProfSrc, e.profSrc, e.profSrcMem, VK_FORMAT_R32_SFLOAT, w, h) ||
+            !criaImagem(e.ciMvSrc, e.mvSrc, e.mvSrcMem, VK_FORMAT_R32G32_SFLOAT, w, h))
+            return false;
+        const VkDeviceSize tam = static_cast<VkDeviceSize>(w) * h * 12u;
+        for (int i = 0; i < 2; ++i)
+        {
+            VkBufferCreateInfo bi{VK_STRUCTURE_TYPE_BUFFER_CREATE_INFO};
+            bi.size = tam;
+            bi.usage = VK_BUFFER_USAGE_TRANSFER_SRC_BIT;
+            if (vkCreateBuffer(e.dispositivo, &bi, nullptr, &e.envio[i]) != VK_SUCCESS)
+                return false;
+            VkMemoryRequirements req;
+            vkGetBufferMemoryRequirements(e.dispositivo, e.envio[i], &req);
+            VkMemoryAllocateInfo ai{VK_STRUCTURE_TYPE_MEMORY_ALLOCATE_INFO};
+            ai.allocationSize = req.size;
+            ai.memoryTypeIndex = tipoMemoria(req.memoryTypeBits, VK_MEMORY_PROPERTY_HOST_VISIBLE_BIT | VK_MEMORY_PROPERTY_HOST_COHERENT_BIT);
+            if (vkAllocateMemory(e.dispositivo, &ai, nullptr, &e.envioMem[i]) != VK_SUCCESS)
+                return false;
+            vkBindBufferMemory(e.dispositivo, e.envio[i], e.envioMem[i], 0);
+            void *ptr = nullptr;
+            vkMapMemory(e.dispositivo, e.envioMem[i], 0, tam, 0, &ptr);
+            e.envioPtr[i] = static_cast<uint8_t *>(ptr);
+        }
+        e.srcW = w;
+        e.srcH = h;
+        return true;
+    }
+
+    // grava no comando: limpa profundidade (longe) e movimento (zero) e, se houver dados, amplia-os para a área do jogo
+    void gravaMovimento(VkCommandBuffer c, uint32_t slot, const otx_vk::Quadro *qd)
+    {
+        const bool comDados = e.ampliaOk && qd && qd->prof && qd->mv && qd->pw > 0 && qd->ph > 0 && qd->rw > 0.0f && qd->rh > 0.0f;
+        if (comDados && (e.srcW != static_cast<uint32_t>(qd->pw) || e.srcH != static_cast<uint32_t>(qd->ph)))
+            if (!criaFontes(static_cast<uint32_t>(qd->pw), static_cast<uint32_t>(qd->ph)))
+            {
+                log("imagens de envio do movimento falharam; seguindo com movimento zerado");
+                e.ampliaOk = false;
+                return;
+            }
+        const VkImageSubresourceRange r{VK_IMAGE_ASPECT_COLOR_BIT, 0, 1, 0, 1};
+        auto barreira = [&](VkImage img, VkImageLayout de, VkImageLayout para, VkAccessFlags src, VkAccessFlags dst)
+        {
+            VkImageMemoryBarrier b{VK_STRUCTURE_TYPE_IMAGE_MEMORY_BARRIER};
+            b.image = img;
+            b.subresourceRange = r;
+            b.oldLayout = de;
+            b.newLayout = para;
+            b.srcAccessMask = src;
+            b.dstAccessMask = dst;
+            b.srcQueueFamilyIndex = b.dstQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED;
+            vkCmdPipelineBarrier(c, VK_PIPELINE_STAGE_ALL_COMMANDS_BIT, VK_PIPELINE_STAGE_ALL_COMMANDS_BIT, 0, 0, nullptr, 0, nullptr, 1, &b);
+        };
+        barreira(e.prof, VK_IMAGE_LAYOUT_SHADER_READ_ONLY_OPTIMAL, VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL, VK_ACCESS_SHADER_READ_BIT,
+                 VK_ACCESS_TRANSFER_WRITE_BIT);
+        barreira(e.mv, VK_IMAGE_LAYOUT_SHADER_READ_ONLY_OPTIMAL, VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL, VK_ACCESS_SHADER_READ_BIT,
+                 VK_ACCESS_TRANSFER_WRITE_BIT);
+        VkClearColorValue um{};
+        um.float32[0] = 1.0f;
+        VkClearColorValue zero{};
+        vkCmdClearColorImage(c, e.prof, VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL, &um, 1, &r);
+        vkCmdClearColorImage(c, e.mv, VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL, &zero, 1, &r);
+        if (comDados)
+        {
+            const size_t nP = static_cast<size_t>(qd->pw) * qd->ph;
+            std::memcpy(e.envioPtr[slot], qd->prof, nP * 4u);
+            std::memcpy(e.envioPtr[slot] + nP * 4u, qd->mv, nP * 8u);
+            barreira(e.profSrc, VK_IMAGE_LAYOUT_UNDEFINED, VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL, 0, VK_ACCESS_TRANSFER_WRITE_BIT);
+            barreira(e.mvSrc, VK_IMAGE_LAYOUT_UNDEFINED, VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL, 0, VK_ACCESS_TRANSFER_WRITE_BIT);
+            VkBufferImageCopy cp{};
+            cp.imageSubresource = {VK_IMAGE_ASPECT_COLOR_BIT, 0, 0, 1};
+            cp.imageExtent = {static_cast<uint32_t>(qd->pw), static_cast<uint32_t>(qd->ph), 1};
+            cp.bufferOffset = 0;
+            vkCmdCopyBufferToImage(c, e.envio[slot], e.profSrc, VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL, 1, &cp);
+            cp.bufferOffset = nP * 4u;
+            vkCmdCopyBufferToImage(c, e.envio[slot], e.mvSrc, VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL, 1, &cp);
+            barreira(e.profSrc, VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL, VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL, VK_ACCESS_TRANSFER_WRITE_BIT,
+                     VK_ACCESS_TRANSFER_READ_BIT);
+            barreira(e.mvSrc, VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL, VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL, VK_ACCESS_TRANSFER_WRITE_BIT,
+                     VK_ACCESS_TRANSFER_READ_BIT);
+            // a limpeza e a ampliação escrevem na mesma imagem: uma barreira entre elas
+            barreira(e.prof, VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL, VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL, VK_ACCESS_TRANSFER_WRITE_BIT,
+                     VK_ACCESS_TRANSFER_WRITE_BIT);
+            barreira(e.mv, VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL, VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL, VK_ACCESS_TRANSFER_WRITE_BIT,
+                     VK_ACCESS_TRANSFER_WRITE_BIT);
+            VkImageBlit bl{};
+            bl.srcSubresource = bl.dstSubresource = {VK_IMAGE_ASPECT_COLOR_BIT, 0, 0, 1};
+            bl.srcOffsets[1] = {qd->pw, qd->ph, 1};
+            const int32_t x0 = std::max(0, static_cast<int32_t>(qd->rx)), y0 = std::max(0, static_cast<int32_t>(qd->ry));
+            const int32_t x1 = std::min(static_cast<int32_t>(e.tamTroca.width), static_cast<int32_t>(qd->rx + qd->rw));
+            const int32_t y1 = std::min(static_cast<int32_t>(e.tamTroca.height), static_cast<int32_t>(qd->ry + qd->rh));
+            bl.dstOffsets[0] = {x0, y0, 0};
+            bl.dstOffsets[1] = {x1, y1, 1};
+            vkCmdBlitImage(c, e.profSrc, VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL, e.prof, VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL, 1, &bl,
+                           VK_FILTER_NEAREST);
+            vkCmdBlitImage(c, e.mvSrc, VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL, e.mv, VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL, 1, &bl,
+                           VK_FILTER_NEAREST);
+        }
+        barreira(e.prof, VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL, VK_IMAGE_LAYOUT_SHADER_READ_ONLY_OPTIMAL, VK_ACCESS_TRANSFER_WRITE_BIT,
+                 VK_ACCESS_SHADER_READ_BIT);
+        barreira(e.mv, VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL, VK_IMAGE_LAYOUT_SHADER_READ_ONLY_OPTIMAL, VK_ACCESS_TRANSFER_WRITE_BIT,
+                 VK_ACCESS_SHADER_READ_BIT);
+    }
+
+    // desfaz o swapchain do FSR e volta a um swapchain comum (troca de tamanho da janela ou falha)
+    void desligaFfx()
+    {
+        if (!e.ctxTroca && !e.ctxFg)
+            return;
+        vkDeviceWaitIdle(e.dispositivo);
+        if (e.ctxTroca)
+        {
+            ffxDispatchDescFrameGenerationSwapChainWaitForPresentsVK w{};
+            w.header.type = FFX_API_DISPATCH_DESC_TYPE_FGSWAPCHAIN_WAIT_FOR_PRESENTS_VK;
+            e.ffx.Dispatch(&e.ctxTroca, &w.header);
+        }
+        if (e.ctxFg)
+            e.ffx.DestroyContext(&e.ctxFg, nullptr);
+        e.ctxFg = nullptr;
+        if (e.ctxTroca)
+            e.ffx.DestroyContext(&e.ctxTroca, nullptr);
+        e.ctxTroca = nullptr;
+        if (e.troca && e.destroiTrocaFfx)
+            e.destroiTrocaFfx(e.dispositivo, e.troca, nullptr, nullptr);
+        e.troca = VK_NULL_HANDLE;
+        e.adquire = nullptr;
+        e.apresentaFfx = nullptr;
+        e.imagensFfx = nullptr;
+        e.contaApres = nullptr;
+        destroiAuxiliares();
+    }
+
+    // troca o swapchain comum pelo do FSR 3.1 e cria o contexto de geração de quadros
+    bool ligaFfx()
+    {
+        if (!e.ffxDll)
+        {
+            wchar_t caminho[MAX_PATH];
+            GetModuleFileNameW(nullptr, caminho, MAX_PATH);
+            wchar_t *barra = wcsrchr(caminho, L'\\');
+            if (barra)
+                barra[1] = 0;
+            wcscat_s(caminho, L"amd_fidelityfx_loader_vk.dll");
+            e.ffxDll = LoadLibraryW(caminho);
+            if (!e.ffxDll)
+            {
+                log("amd_fidelityfx_loader_vk.dll não encontrada ao lado do .exe; sem FSR 3.1");
+                return false;
+            }
+            ffxLoadFunctions(&e.ffx, e.ffxDll);
+            if (!e.ffx.CreateContext || !e.ffx.Configure || !e.ffx.Dispatch || !e.ffx.Query)
+            {
+                log("a DLL do FSR não tem as funções esperadas");
+                return false;
+            }
+        }
+        ffxCreateContextDescFrameGenerationSwapChainVersionVK ver{};
+        ver.header.type = FFX_API_CREATE_CONTEXT_DESC_TYPE_FRAMEGENERATIONSWAPCHAIN_VERSION_VK;
+        ver.version = FFX_FRAMEGENERATION_SWAPCHAIN_VK_VERSION;
+        ffxCreateContextDescFrameGenerationSwapChainVK d{};
+        d.header.type = FFX_API_CREATE_CONTEXT_DESC_TYPE_FGSWAPCHAIN_VK;
+        d.header.pNext = &ver.header;
+        d.physicalDevice = e.fisico;
+        d.device = e.dispositivo;
+        d.swapchain = &e.troca;
+        d.allocator = nullptr;
+        d.createInfo = e.ciTroca;
+        d.createInfo.oldSwapchain = e.troca;
+        d.gameQueue = {e.fila, e.familia, nullptr};
+        d.asyncComputeQueue = {e.filaAsync, e.familiaAsync, nullptr};
+        d.presentQueue = {e.filaApres, e.familia, nullptr};
+        d.imageAcquireQueue = {e.filaAdq, e.familia, nullptr};
+        ffxReturnCode_t rc = e.ffx.CreateContext(&e.ctxTroca, &d.header, nullptr);
+        if (rc != FFX_API_RETURN_OK)
+        {
+            std::fprintf(stderr, "[vulkan] swapchain do FSR falhou (código %u)\n", rc);
+            e.ctxTroca = nullptr;
+            return false;
+        }
+        ffxQueryDescSwapchainReplacementFunctionsVK fn{};
+        fn.header.type = FFX_API_QUERY_DESC_TYPE_FGSWAPCHAIN_FUNCTIONS_VK;
+        e.ffx.Query(&e.ctxTroca, &fn.header);
+        e.adquire = fn.pOutAcquireNextImageKHR;
+        e.apresentaFfx = fn.pOutQueuePresentKHR;
+        e.imagensFfx = fn.pOutGetSwapchainImagesKHR;
+        e.destroiTrocaFfx = fn.pOutDestroySwapchainFFXAPI;
+        e.contaApres = fn.pOutGetLastPresentCountFFXAPI;
+        if (!e.adquire || !e.apresentaFfx || !e.imagensFfx)
+        {
+            log("o FSR não devolveu as funções do swapchain");
+            return false;
+        }
+        uint32_t n = 0;
+        e.imagensFfx(e.dispositivo, e.troca, &n, nullptr);
+        e.imagensTroca.resize(n);
+        e.imagensFfx(e.dispositivo, e.troca, &n, e.imagensTroca.data());
+
+        ffxCreateBackendVKDesc be{};
+        be.header.type = FFX_API_CREATE_CONTEXT_DESC_TYPE_BACKEND_VK;
+        be.deviceContext.vkDevice = e.dispositivo;
+        be.deviceContext.vkPhysicalDevice = e.fisico;
+        be.deviceContext.vkDeviceProcAddr = vkGetDeviceProcAddr;
+        ffxCreateContextDescFrameGenerationVersion vfg{};
+        vfg.header.type = FFX_API_CREATE_CONTEXT_DESC_TYPE_FRAMEGENERATION_VERSION;
+        vfg.header.pNext = &be.header;
+        vfg.version = FFX_FRAMEGENERATION_VERSION;
+        ffxCreateContextDescFrameGeneration cfg{};
+        cfg.header.type = FFX_API_CREATE_CONTEXT_DESC_TYPE_FRAMEGENERATION;
+        cfg.header.pNext = &vfg.header;
+        cfg.flags = FFX_FRAMEGENERATION_ENABLE_DISPLAY_RESOLUTION_MOTION_VECTORS;
+        if (std::getenv("PS2X_FSR_FG_CHECA"))
+            cfg.flags |= FFX_FRAMEGENERATION_ENABLE_DEBUG_CHECKING;
+        cfg.displaySize = {e.tamTroca.width, e.tamTroca.height};
+        cfg.maxRenderSize = cfg.displaySize;
+        cfg.backBufferFormat = ffxApiGetSurfaceFormatVK(e.formatoTroca);
+        rc = e.ffx.CreateContext(&e.ctxFg, &cfg.header, nullptr);
+        if (rc != FFX_API_RETURN_OK)
+        {
+            std::fprintf(stderr, "[vulkan] contexto de geração de quadros do FSR falhou (código %u)\n", rc);
+            e.ctxFg = nullptr;
+            return false;
+        }
+        {
+            // a ampliação da profundidade/movimento precisa de blit nesses formatos
+            VkFormatProperties f1, f2;
+            vkGetPhysicalDeviceFormatProperties(e.fisico, VK_FORMAT_R32_SFLOAT, &f1);
+            vkGetPhysicalDeviceFormatProperties(e.fisico, VK_FORMAT_R32G32_SFLOAT, &f2);
+            const VkFormatFeatureFlags quer = VK_FORMAT_FEATURE_BLIT_SRC_BIT | VK_FORMAT_FEATURE_BLIT_DST_BIT;
+            e.ampliaOk = (f1.optimalTilingFeatures & quer) == quer && (f2.optimalTilingFeatures & quer) == quer;
+            if (!e.ampliaOk)
+                log("a placa não amplia R32F/RG32F; vetores de movimento ficam zerados");
+        }
+        if (!criaAuxiliares(e.tamTroca.width, e.tamTroca.height))
+        {
+            log("imagens de profundidade/movimento falharam");
+            return false;
+        }
+        {
+            // versão que a DLL escolheu (a 4.0 só roda nas Radeon RX 9000; nas outras placas cai para a 3.1.x)
+            ffxQueryGetProviderVersion pv{};
+            pv.header.type = FFX_API_QUERY_DESC_TYPE_GET_PROVIDER_VERSION;
+            if (e.ffx.Query(&e.ctxFg, &pv.header) == FFX_API_RETURN_OK)
+                std::fprintf(stderr, "[vulkan] FSR geração de quadros: %s\n", pv.versionName ? pv.versionName : "?");
+        }
+        e.idQuadro = 0;
+        e.tAnt.QuadPart = 0;
+        return true;
+    }
+#endif
+
+    // refaz o swapchain no tamanho novo; com o FSR ligado, ele é refeito do zero
+    void refazTroca(uint32_t w, uint32_t h)
+    {
+#if defined(PS2X_TEM_FFX)
+        if (e.fg)
+        {
+            desligaFfx();
+            criaTroca(w, h);
+            if (!ligaFfx())
+            {
+                log("o FSR não voltou depois da mudança de tamanho; seguindo sem geração de quadros");
+                desligaFfx();
+                e.fg = false;
+                if (!e.troca)
+                    criaTroca(w, h);
+            }
+            return;
+        }
+#endif
+        criaTroca(w, h);
+    }
+}
