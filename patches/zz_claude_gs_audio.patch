+        std::fprintf(stderr, "[present] recente: %d (max %.1f ms, %d >10ms) | cópia imediata: %d (max %.1f ms, %d >10ms)\n", n[0], mx[0], n10[0], n[1], mx[1], n10[1]);
+        mx[0] = mx[1] = 0;
+        n[0] = n[1] = n10[0] = n10[1] = 0;
+        tLog = agora;
+    }
+}
