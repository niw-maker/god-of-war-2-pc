+// Claude (08/11/2026): PS2X_GRAVA=<arquivo.mkv> grava em vídeo a janela do jogo como aparece na tela (com os quadros gerados
+// pelo FSR), usando o ffmpeg instalado. Serve para analisar travadas depois (modo diagnóstico do launcher).
+// Tenta, em ordem: duplicação de tela do DirectX (ddagrab) com a placa de vídeo codificando (NVENC); ddagrab com x264;
+// captura GDI com NVENC; GDI com x264. O ffmpeg fica num job object: se o jogo fechar à força, ele fecha junto. Numa saída
+// normal recebe "q" e fecha o arquivo direito. Se a janela mudar de tamanho, a gravação continua num arquivo novo (_2, _3...).
+// PS2X_GRAVA_FPS muda a taxa (padrão 60; 120 com a geração de quadros do FSR).
+#include "otx_grava.h"
+
+#if defined(_WIN32)
+#define WIN32_LEAN_AND_MEAN
+#define NOMINMAX
+#include <windows.h>
+#include <dxgi.h>
+#pragma comment(lib, "dxgi.lib")
+
+#include <algorithm>
+#include <chrono>
+#include <cstdio>
+#include <cstdlib>
+#include <string>
+#include <thread>
+
+namespace
+{
+    struct Gravador
+    {
+        bool desligado = false;
+        bool iniciou = false;
+        std::wstring base, ffmpeg;
+        int parte = 0;
+        HANDLE job = nullptr;
+        PROCESS_INFORMATION pi{};
+        HANDLE entrada = nullptr; // escrita no stdin do ffmpeg
+        RECT area{};              // área gravada (coordenadas da tela)
+        std::chrono::steady_clock::time_point ultimaChecagem{};
+    } g;
+
+    std::wstring larga(const char *s)
+    {
+        if (!s)
+            return L"";
+        const int n = MultiByteToWideChar(CP_UTF8, 0, s, -1, nullptr, 0);
+        std::wstring w(n > 0 ? n - 1 : 0, L'\0');
+        if (n > 1)
+            MultiByteToWideChar(CP_UTF8, 0, s, -1, &w[0], n);
+        return w;
+    }
+
+    // área cliente da janela em coordenadas da tela, com largura e altura pares (exigência do H.264)
+    bool areaDaJanela(HWND h, RECT &r)
+    {
+        RECT c;
+        if (!h || !GetClientRect(h, &c))
+            return false;
+        POINT p{0, 0};
+        ClientToScreen(h, &p);
+        const LONG w = (c.right - c.left) & ~1L, a = (c.bottom - c.top) & ~1L;
+        if (w < 16 || a < 16)
+            return false;
+        r = {p.x, p.y, p.x + w, p.y + a};
+        return true;
+    }
+
+    // índice da saída (monitor) do adaptador 0 que contém o ponto; -1 se o monitor estiver em outra placa
+    int saidaDoAdaptador0(POINT p, RECT &mon)
+    {
+        IDXGIFactory1 *f = nullptr;
+        if (FAILED(CreateDXGIFactory1(__uuidof(IDXGIFactory1), reinterpret_cast<void **>(&f))))
+            return -1;
+        int achou = -1;
+        IDXGIAdapter1 *a = nullptr;
+        if (SUCCEEDED(f->EnumAdapters1(0, &a)))
+        {
+            IDXGIOutput *o = nullptr;
+            for (UINT i = 0; a->EnumOutputs(i, &o) != DXGI_ERROR_NOT_FOUND; ++i)
+            {
+                DXGI_OUTPUT_DESC d;
+                if (SUCCEEDED(o->GetDesc(&d)) && PtInRect(&d.DesktopCoordinates, p))
+                {
+                    achou = static_cast<int>(i);
+                    mon = d.DesktopCoordinates;
+                }
+                o->Release();
+                if (achou >= 0)
+                    break;
+            }
+            a->Release();
+        }
+        f->Release();
+        return achou;
+    }
+
+    void para()
+    {
+        if (!g.pi.hProcess)
+            return;
+        DWORD escrito = 0;
+        if (g.entrada)
+        {
+            WriteFile(g.entrada, "q", 1, &escrito, nullptr);
+            CloseHandle(g.entrada);
+            g.entrada = nullptr;
+        }
+        if (WaitForSingleObject(g.pi.hProcess, 8000) != WAIT_OBJECT_0)
+            TerminateProcess(g.pi.hProcess, 1);
+        CloseHandle(g.pi.hProcess);
+        CloseHandle(g.pi.hThread);
+        g.pi = PROCESS_INFORMATION{};
+    }
+
+    // abre o ffmpeg com uma linha de comando; true se ele ainda estiver rodando 2,5 s depois
+    bool tenta(const std::wstring &args, const std::wstring &arqLog)
+    {
+        SECURITY_ATTRIBUTES sa{sizeof sa, nullptr, TRUE};
+        HANDLE leitura = nullptr, escrita = nullptr;
+        if (!CreatePipe(&leitura, &escrita, &sa, 0))
+            return false;
+        SetHandleInformation(escrita, HANDLE_FLAG_INHERIT, 0);
+        HANDLE log = CreateFileW(arqLog.c_str(), GENERIC_WRITE, FILE_SHARE_READ, &sa, CREATE_ALWAYS, FILE_ATTRIBUTE_NORMAL, nullptr);
+        STARTUPINFOW si{sizeof si};
+        si.dwFlags = STARTF_USESTDHANDLES;
+        si.hStdInput = leitura;
+        si.hStdOutput = log;
+        si.hStdError = log;
+        std::wstring cmd = L"\"" + g.ffmpeg + L"\" " + args;
+        PROCESS_INFORMATION pi{};
+        const BOOL ok = CreateProcessW(nullptr, &cmd[0], nullptr, nullptr, TRUE, CREATE_NO_WINDOW | BELOW_NORMAL_PRIORITY_CLASS | CREATE_SUSPENDED,
+                                       nullptr, nullptr, &si, &pi);
+        CloseHandle(leitura);
+        if (log != INVALID_HANDLE_VALUE)
+            CloseHandle(log);
+        if (!ok)
+        {
+            CloseHandle(escrita);
+            return false;
+        }
+        if (g.job)
+            AssignProcessToJobObject(g.job, pi.hProcess);
+        ResumeThread(pi.hThread);
+        if (WaitForSingleObject(pi.hProcess, 2500) == WAIT_OBJECT_0)
+        {
+            CloseHandle(pi.hProcess);
+            CloseHandle(pi.hThread);
+            CloseHandle(escrita);
+            return false;
+        }
+        g.pi = pi;
+        g.entrada = escrita;
+        return true;
+    }
+
+    void comeca(HWND h)
+    {
+        RECT r;
+        if (!areaDaJanela(h, r))
+            return;
+        ++g.parte;
+        std::wstring arq = g.base;
+        if (g.parte > 1)
+        {
+            const size_t ponto = arq.find_last_of(L'.');
+            const std::wstring sufixo = L"_" + std::to_wstring(g.parte);
+            arq = ponto == std::wstring::npos ? arq + sufixo : arq.substr(0, ponto) + sufixo + arq.substr(ponto);
+        }
+        const std::wstring arqLog = arq + L".ffmpeg.txt";
+        const char *ef = std::getenv("PS2X_GRAVA_FPS");
+        const char *fg = std::getenv("PS2X_FSR_FG");
+        const int fps = ef ? std::max(10, std::atoi(ef)) : (fg && fg[0] == '1' ? 120 : 60);
+        const LONG w = r.right - r.left, a = r.bottom - r.top;
+        const std::wstring nv = L" -c:v h264_nvenc -preset p3 -rc vbr -cq 24 -b:v 0 ";
+        const std::wstring x264 = L" -c:v libx264 -preset ultrafast -crf 24 -pix_fmt yuv420p ";
+        const std::wstring saida = L"-y \"" + arq + L"\"";
+        const std::wstring comum = L"-hide_banner -loglevel warning ";
+        std::wstring tentativas[4];
+        int nT = 0;
+        RECT mon{};
+        const int saidaIdx = saidaDoAdaptador0(POINT{r.left + 1, r.top + 1}, mon);
+        if (saidaIdx >= 0)
+        {
+            const std::wstring dda = L"-f lavfi -i \"ddagrab=output_idx=" + std::to_wstring(saidaIdx) + L":framerate=" + std::to_wstring(fps) +
+                                     L":video_size=" + std::to_wstring(w) + L"x" + std::to_wstring(a) + L":offset_x=" +
+                                     std::to_wstring(r.left - mon.left) + L":offset_y=" + std::to_wstring(r.top - mon.top) + L":draw_mouse=0\" ";
+            tentativas[nT++] = comum + dda + nv + saida;
+            tentativas[nT++] = comum + dda + L"-vf hwdownload,format=bgra" + x264 + saida;
+        }
+        const std::wstring gdi = L"-f gdigrab -framerate " + std::to_wstring(fps) + L" -offset_x " + std::to_wstring(r.left) + L" -offset_y " +
+                                 std::to_wstring(r.top) + L" -video_size " + std::to_wstring(w) + L"x" + std::to_wstring(a) +
+                                 L" -draw_mouse 0 -i desktop ";
+        tentativas[nT++] = comum + gdi + nv + saida;
+        tentativas[nT++] = comum + gdi + x264 + saida;
+        for (int i = 0; i < nT; ++i)
+            if (tenta(tentativas[i], arqLog))
+            {
+                g.area = r;
+                std::fprintf(stderr, "[grava] gravando %ldx%ld a %d qps (parte %d, modo %d de %d)\n", w, a, fps, g.parte, i + 1, nT);
+                return;
+            }
+        std::fprintf(stderr, "[grava] o ffmpeg não conseguiu gravar (veja %ls); gravação desligada\n", arqLog.c_str());
+        g.desligado = true;
+    }
+
+    void aoSair() { para(); }
+}
+
+void otxGrava(void *hwnd)
+{
+    if (g.desligado)
+        return;
+    if (!g.iniciou)
+    {
+        g.iniciou = true;
+        const char *arq = std::getenv("PS2X_GRAVA");
+        if (!arq || !*arq)
+        {
+            g.desligado = true;
+            return;
+        }
+        g.base = larga(arq);
+        const char *ef = std::getenv("PS2X_FFMPEG");
+        if (ef && *ef)
+            g.ffmpeg = larga(ef);
+        else
+        {
+            wchar_t achado[MAX_PATH];
+            if (SearchPathW(nullptr, L"ffmpeg.exe", nullptr, MAX_PATH, achado, nullptr))
+                g.ffmpeg = achado;
+        }
+        if (g.ffmpeg.empty())
+        {
+            std::fprintf(stderr, "[grava] ffmpeg.exe não encontrado (instale ou aponte PS2X_FFMPEG); gravação desligada\n");
+            g.desligado = true;
+            return;
+        }
+        g.job = CreateJobObjectW(nullptr, nullptr);
+        if (g.job)
+        {
+            JOBOBJECT_EXTENDED_LIMIT_INFORMATION li{};
+            li.BasicLimitInformation.LimitFlags = JOB_OBJECT_LIMIT_KILL_ON_JOB_CLOSE;
+            SetInformationJobObject(g.job, JobObjectExtendedLimitInformation, &li, sizeof li);
+        }
+        std::atexit(aoSair);
+    }
+    const auto agora = std::chrono::steady_clock::now();
+    if (agora - g.ultimaChecagem < std::chrono::seconds(1))
+        return;
+    g.ultimaChecagem = agora;
+    HWND h = static_cast<HWND>(hwnd);
+    if (IsIconic(h))
+        return;
+    RECT r;
+    if (!areaDaJanela(h, r))
+        return;
+    if (g.pi.hProcess && WaitForSingleObject(g.pi.hProcess, 0) == WAIT_OBJECT_0)
+    {
+        // o ffmpeg caiu: recomeça num arquivo novo
+        CloseHandle(g.pi.hProcess);
+        CloseHandle(g.pi.hThread);
+        g.pi = PROCESS_INFORMATION{};
+        if (g.entrada)
+            CloseHandle(g.entrada);
+        g.entrada = nullptr;
+    }
+    if (g.pi.hProcess && EqualRect(&r, &g.area))
+        return;
+    para();
+    if (g.parte >= 50)
+    {
+        g.desligado = true;
+        return;
+    }
+    comeca(h);
+}
+
+void otxGravaPara() { para(); }
+#else
+void otxGrava(void *) {}
+void otxGravaPara() {}
+#endif
