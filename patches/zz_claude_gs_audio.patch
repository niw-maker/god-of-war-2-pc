+                    for (int j = 0; j < 3; ++j)
+                        C[i * 4 + j] = V[j * 4 + i];
+                for (int j = 0; j < 3; ++j)
+                    C[12 + j] = -(V[12] * C[0 * 4 + j] + V[13] * C[1 * 4 + j] + V[14] * C[2 * 4 + j]);
