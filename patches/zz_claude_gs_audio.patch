+                const double dx = C[12] - p.pos[0], dy = C[13] - p.pos[1], dz = C[14] - p.pos[2];
+                const float dist = static_cast<float>(std::sqrt(dx * dx + dy * dy + dz * dz));
+                menorVista = std::min(menorVista, dist);
+                if (dist < melhorDist)
+                {
+                    melhorDist = dist;
+                    for (int i = 0; i < 16; ++i)
+                        camSaida[i] = static_cast<float>(C[i]);
+                    achou = true;
+                }
+            }
+        }
+        // diagnóstico (PS2X_LOG_FPS): de vez em quando, quantas matrizes passaram na assinatura e a menor distância
