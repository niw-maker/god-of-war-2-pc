+    void destroiAuxiliares()
+    {
+        if (e.prof)
+            vkDestroyImage(e.dispositivo, e.prof, nullptr);
+        if (e.mv)
+            vkDestroyImage(e.dispositivo, e.mv, nullptr);
+        if (e.profMem)
+            vkFreeMemory(e.dispositivo, e.profMem, nullptr);
