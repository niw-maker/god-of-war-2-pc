+#include <algorithm>
+#include <cmath>
+
+// Claude (08/11/2026): profundidade e vetores de movimento da câmera para o FSR 3.1, a partir do Z24 do GS.
+// Convenção validada com fluxo óptico (erro mediano 3,2 px, contra 11 px com a imagem parada): a câmera->mundo C tem as
+// linhas direita, cima, trás e posição (vetor-linha: p_mundo = p_cam * C); a câmera olha para -z; o y da tela desce;
+// foco x = P[0][0] e foco y = |P[1][1]| sobre a largura e a altura da imagem; distância = b / (a - Z), com a e b tirados
+// da projeção (ajuste com P22 = -1,002 e P32 = -20,02: a = 8,79e6, b = 6,48e8).
+namespace
+{
+    bool inverte4(const float *m, double *r)
+    {
+        double a[16];
+        for (int i = 0; i < 16; ++i)
+            a[i] = m[i];
+        double inv[16];
+        inv[0] = a[5] * a[10] * a[15] - a[5] * a[11] * a[14] - a[9] * a[6] * a[15] + a[9] * a[7] * a[14] + a[13] * a[6] * a[11] - a[13] * a[7] * a[10];
+        inv[4] = -a[4] * a[10] * a[15] + a[4] * a[11] * a[14] + a[8] * a[6] * a[15] - a[8] * a[7] * a[14] - a[12] * a[6] * a[11] + a[12] * a[7] * a[10];
+        inv[8] = a[4] * a[9] * a[15] - a[4] * a[11] * a[13] - a[8] * a[5] * a[15] + a[8] * a[7] * a[13] + a[12] * a[5] * a[11] - a[12] * a[7] * a[9];
+        inv[12] = -a[4] * a[9] * a[14] + a[4] * a[10] * a[13] + a[8] * a[5] * a[14] - a[8] * a[6] * a[13] - a[12] * a[5] * a[10] + a[12] * a[6] * a[9];
+        inv[1] = -a[1] * a[10] * a[15] + a[1] * a[11] * a[14] + a[9] * a[2] * a[15] - a[9] * a[3] * a[14] - a[13] * a[2] * a[11] + a[13] * a[3] * a[10];
+        inv[5] = a[0] * a[10] * a[15] - a[0] * a[11] * a[14] - a[8] * a[2] * a[15] + a[8] * a[3] * a[14] + a[12] * a[2] * a[11] - a[12] * a[3] * a[10];
+        inv[9] = -a[0] * a[9] * a[15] + a[0] * a[11] * a[13] + a[8] * a[1] * a[15] - a[8] * a[3] * a[13] - a[12] * a[1] * a[11] + a[12] * a[3] * a[9];
+        inv[13] = a[0] * a[9] * a[14] - a[0] * a[10] * a[13] - a[8] * a[1] * a[14] + a[8] * a[2] * a[13] + a[12] * a[1] * a[10] - a[12] * a[2] * a[9];
+        inv[2] = a[1] * a[6] * a[15] - a[1] * a[7] * a[14] - a[5] * a[2] * a[15] + a[5] * a[3] * a[14] + a[13] * a[2] * a[7] - a[13] * a[3] * a[6];
+        inv[6] = -a[0] * a[6] * a[15] + a[0] * a[7] * a[14] + a[4] * a[2] * a[15] - a[4] * a[3] * a[14] - a[12] * a[2] * a[7] + a[12] * a[3] * a[6];
+        inv[10] = a[0] * a[5] * a[15] - a[0] * a[7] * a[13] - a[4] * a[1] * a[15] + a[4] * a[3] * a[13] + a[12] * a[1] * a[7] - a[12] * a[3] * a[5];
+        inv[14] = -a[0] * a[5] * a[14] + a[0] * a[6] * a[13] + a[4] * a[1] * a[14] - a[4] * a[2] * a[13] - a[12] * a[1] * a[6] + a[12] * a[2] * a[5];
+        inv[3] = -a[1] * a[6] * a[11] + a[1] * a[7] * a[10] + a[5] * a[2] * a[11] - a[5] * a[3] * a[10] - a[9] * a[2] * a[7] + a[9] * a[3] * a[6];
+        inv[7] = a[0] * a[6] * a[11] - a[0] * a[7] * a[10] - a[4] * a[2] * a[11] + a[4] * a[3] * a[10] + a[8] * a[2] * a[7] - a[8] * a[3] * a[6];
+        inv[11] = -a[0] * a[5] * a[11] + a[0] * a[7] * a[9] + a[4] * a[1] * a[11] - a[4] * a[3] * a[9] - a[8] * a[1] * a[7] + a[8] * a[3] * a[5];
+        inv[15] = a[0] * a[5] * a[10] - a[0] * a[6] * a[9] - a[4] * a[1] * a[10] + a[4] * a[2] * a[9] + a[8] * a[1] * a[6] - a[8] * a[2] * a[5];
+        const double det = a[0] * inv[0] + a[1] * inv[4] + a[2] * inv[8] + a[3] * inv[12];
+        if (!(std::fabs(det) > 1e-12))
+            return false;
+        for (int i = 0; i < 16; ++i)
+            r[i] = inv[i] / det;
+        return true;
+    }
+
+    // perto, longe, foco e mapeamento Z->distância de uma projeção do jogo
+    bool lerProjecao(const float *p, double &fx, double &fy, double &perto, double &longe, double &a, double &b)
+    {
+        fx = p[0];
+        fy = std::fabs(p[5]);
+        const double p22 = p[10];
+        const double p32 = std::fabs(p[14]) > std::fabs(p[11]) ? p[14] : p[11];
+        if (!(fx > 0.05 && fx < 50.0 && fy > 0.05 && fy < 50.0) || std::fabs(p22 + 1.0) < 1e-6 || std::fabs(p22 - 1.0) < 1e-6)
+            return false;
+        perto = p32 / (p22 - 1.0);
+        longe = p32 / (p22 + 1.0);
+        if (!(perto > 0.0 && longe > perto))
+            return false;
+        constexpr double kA = 6.48e8 / 20.02, kB = 8.79e6 - 1.002 * (6.48e8 / 20.02);
+        a = -p22 * kA + kB;
+        b = -p32 * kA;
+        return b > 0.0;
+    }
+}
+
+namespace otx_vk
+{
+    bool calculaMovimento(const unsigned int *z, int w, int h, const float *camAtual, const float *camAnt, float escX, float escY,
+                          float *prof, float *mv, float &perto, float &longe, float &fovY)
+    {
+        double fxA, fyA, nA, lA, aA, bA, fxB, fyB, nB, lB, aB, bB;
+        if (!z || w <= 0 || h <= 0 || !lerProjecao(camAtual + 16, fxA, fyA, nA, lA, aA, bA) ||
+            !lerProjecao(camAnt + 16, fxB, fyB, nB, lB, aB, bB))
+            return false;
+        (void)nB;
+        (void)lB;
+        (void)aB;
+        (void)bB;
+        double invB[16];
+        if (!inverte4(camAnt, invB))
+            return false;
+        // M = C_atual * inv(C_anterior): vista atual -> vista anterior
+        double M[16];
+        for (int i = 0; i < 4; ++i)
+            for (int j = 0; j < 4; ++j)
+            {
+                double s = 0.0;
+                for (int k = 0; k < 4; ++k)
+                    s += static_cast<double>(camAtual[i * 4 + k]) * invB[k * 4 + j];
+                M[i * 4 + j] = s;
+            }
+        perto = static_cast<float>(nA);
+        longe = static_cast<float>(lA);
+        fovY = static_cast<float>(2.0 * std::atan(1.0 / fyA));
+        const float kProf = static_cast<float>(lA / (lA - nA));
+        for (int y = 0; y < h; ++y)
+        {
+            const double ny = (y + 0.5) / h * 2.0 - 1.0;
+            for (int x = 0; x < w; ++x)
+            {
+                const int i = y * w + x;
+                const double nx = (x + 0.5) / w * 2.0 - 1.0;
+                const double zv = static_cast<double>(z[i]);
+                double vx, vy, vz, vw;
+                if (zv >= aA * 0.99999)
+                {
+                    // infinito (céu): só a rotação conta
+                    vx = nx / fxA;
+                    vy = -ny / fyA;
+                    vz = -1.0;
+                    vw = 0.0;
+                    prof[i] = 1.0f;
+                }
+                else
+                {
+                    const double d = bA / (aA - zv);
+                    vx = nx / fxA * d;
+                    vy = -ny / fyA * d;
+                    vz = -d;
+                    vw = 1.0;
+                    prof[i] = d >= lA ? 1.0f : std::min(1.0f, std::max(0.0f, kProf * static_cast<float>(1.0 - nA / std::max(d, nA))));
+                }
+                const double qx = vx * M[0] + vy * M[4] + vz * M[8] + vw * M[12];
+                const double qy = vx * M[1] + vy * M[5] + vz * M[9] + vw * M[13];
+                const double qz = vx * M[2] + vy * M[6] + vz * M[10] + vw * M[14];
+                const double db = -qz;
+                if (db <= 1e-4)
+                {
+                    mv[2 * i] = mv[2 * i + 1] = 0.0f;
+                    continue;
+                }
+                const double bx = (qx / db * fxB + 1.0) * 0.5 * w - 0.5;
+                const double by = (-qy / db * fyB + 1.0) * 0.5 * h - 0.5;
+                mv[2 * i] = static_cast<float>((bx - x) * escX);
+                mv[2 * i + 1] = static_cast<float>((by - y) * escY);
+            }
+        }
+        return true;
+    }
+}
