+// Claude (07/11): frame generation (PS2X_FG=1). Procura em baixa resolução o deslocamento d que melhor casa anterior(p - d) com
+// atual(p + d), centrado no meio do caminho, o que evita buracos na imagem gerada. Mostra o quadro um quadro real depois, com
+// alfa pelo tempo: é esse o atraso que o método custa. Com o jogo perto da taxa da tela, ou depois de uma pausa, não gera nada.
+namespace
+{
+    const char *kFgLuma = R"GLSL(#version 330
+in vec2 fragTexCoord;
+uniform sampler2D texture0;
+out vec4 finalColor;
+void main()
+{
+    float y = dot(texture(texture0, fragTexCoord).rgb, vec3(0.299, 0.587, 0.114));
+    finalColor = vec4(y, y, y, 1.0);
+}
+)GLSL";
+    // busca exaustiva de +-8 texels da luminância (256x224): +-32 pixels de 512x448 de movimento entre os quadros
+    const char *kFgBusca = R"GLSL(#version 330
+in vec2 fragTexCoord;
+uniform sampler2D texture0; // luminância do quadro atual
+uniform sampler2D lumAnt;
+uniform vec2 texel;
+out vec4 finalColor;
+const vec2 tap[5] = vec2[5](vec2(0.0), vec2(-2.0, -2.0), vec2(2.0, -2.0), vec2(-2.0, 2.0), vec2(2.0, 2.0));
+void main()
+{
+    float melhor = 1e9;
+    vec2 melhorD = vec2(0.0);
+    for (int dy = -8; dy <= 8; ++dy)
+        for (int dx = -8; dx <= 8; ++dx)
+        {
+            vec2 d = vec2(float(dx), float(dy));
+            float soma = 0.0;
+            for (int k = 0; k < 5; ++k)
+            {
+                vec2 q = fragTexCoord + tap[k] * texel;
+                soma += abs(texture(texture0, q + d * texel).r - texture(lumAnt, q - d * texel).r);
+            }
+            // prefere vetores curtos: em área lisa qualquer vetor casa
+            float custo = soma + 0.004 * length(d);
+            if (custo < melhor)
+            {
+                melhor = custo;
+                melhorD = d;
+            }
+        }
+    // inteiro exato no alvo de 8 bits: -8..8 vira 64..192 (o 0,5 virava 128/255 e dava um desvio fixo)
+    finalColor = vec4((melhorD * 8.0 + 128.0) / 255.0, 0.0, 1.0);
+}
+)GLSL";
+    // mediana vetorial 3x3 do campo: tira vetores isolados
+    const char *kFgMediana = R"GLSL(#version 330
+in vec2 fragTexCoord;
+uniform sampler2D texture0;
+uniform vec2 texel;
+out vec4 finalColor;
+void main()
+{
+    vec4 v[9];
+    int n = 0;
+    for (int y = -1; y <= 1; ++y)
+        for (int x = -1; x <= 1; ++x)
+            v[n++] = texture(texture0, fragTexCoord + vec2(float(x), float(y)) * texel);
+    float melhor = 1e9;
+    vec4 saida = v[4];
+    for (int i = 0; i < 9; ++i)
+    {
+        float s = 0.0;
+        for (int j = 0; j < 9; ++j)
+            s += distance(v[i].xy, v[j].xy);
+        if (s < melhor)
+        {
+            melhor = s;
+            saida = v[i];
+        }
+    }
+    finalColor = saida;
+}
+)GLSL";
+    const char *kFgGera = R"GLSL(#version 330
+in vec2 fragTexCoord;
+uniform sampler2D texture0; // quadro atual
+uniform sampler2D quadroAnt;
+uniform sampler2D campo;
+uniform vec2 passoLuma;
+uniform vec2 passoCampo;
+uniform vec2 passoQuadro;
+uniform float alfa;
+uniform float soMistura;
+out vec4 finalColor;
+float erroVetor(vec2 uv, vec2 d)
+{
+    // erro numa cruz de 5 pontos: um pixel só escolheria vetores pelo ruído
+    const vec2 cruz[5] = vec2[5](vec2(0.0), vec2(-1.5, 0.0), vec2(1.5, 0.0), vec2(0.0, -1.5), vec2(0.0, 1.5));
+    float e = 0.0;
+    for (int k = 0; k < 5; ++k)
+    {
+        vec2 q = uv + cruz[k] * passoQuadro;
+        e += dot(abs(texture(quadroAnt, q - d).rgb - texture(texture0, q + d).rgb), vec3(0.333));
+    }
+    return e;
+}
+void main()
+{
+    vec2 uv = fragTexCoord;
+    if (soMistura > 0.5)
+    {
+        finalColor = vec4(mix(texture(quadroAnt, uv).rgb, texture(texture0, uv).rgb, alfa), 1.0);
+        return;
+    }
+    // Cada pixel escolhe entre os vetores dos blocos em volta e o vetor zero: as bordas passam a seguir o objeto, e não a grade
+    // O bloco do próprio pixel tem vantagem: só troca de vetor com ganho claro, ou a área lisa vira um mosaico de vetores
+    vec2 d = (texture(campo, uv).xy * 255.0 - 128.0) / 8.0 * passoLuma;
+    float melhor = erroVetor(uv, d) - 0.03;
+    float eZero = erroVetor(uv, vec2(0.0)) - 0.03;
+    if (eZero < melhor)
+    {
+        melhor = eZero;
+        d = vec2(0.0);
+    }
+    for (int y = -1; y <= 1; ++y)
+        for (int x = -1; x <= 1; ++x)
+        {
+            if (x == 0 && y == 0)
+                continue;
+            vec2 c = (texture(campo, uv + vec2(float(x), float(y)) * passoCampo).xy * 255.0 - 128.0) / 8.0 * passoLuma;
+            float e = erroVetor(uv, c);
+            if (e < melhor)
+            {
+                melhor = e;
+                d = c;
+            }
+        }
+    vec3 a = texture(quadroAnt, uv - d * 2.0 * alfa).rgb;
+    vec3 b = texture(texture0, uv + d * 2.0 * (1.0 - alfa)).rgb;
+    vec3 z0 = texture(quadroAnt, uv).rgb;
+    vec3 z1 = texture(texture0, uv).rgb;
+    vec3 c = mix(a, b, alfa);
+    // quando os dois lados não casam (oclusão), usa o quadro mais próximo no tempo em vez de um fantasma
+    float difMov = dot(abs(a - b), vec3(0.333));
+    c = mix(c, alfa < 0.5 ? a : b, smoothstep(0.25, 0.5, difMov));
+    // o que não mudou no lugar (HUD, cenário parado) fica parado, em vez de ser arrastado pelo movimento vizinho
+    float difPar = dot(abs(z0 - z1), vec3(0.333));
+    c = mix(mix(z0, z1, alfa), c, smoothstep(0.015, 0.05, difPar));
+    finalColor = vec4(c, 1.0);
+}
+)GLSL";
+
+    struct EstadoFg
+    {
+        bool tentado = false, ok = false;
+        Shader luma{}, busca{}, mediana{}, gera{};
+        int locAnt = -1, locTexelB = -1, locTexelM = -1, locQAnt = -1, locCampo = -1, locPasso = -1, locAlfa = -1, locPassoC = -1, locPassoQ = -1, locSoMistura = -1;
+        RenderTexture2D cur{}, ant{}, lumCur{}, lumAnt{}, campo0{}, campo{}, saida{};
+        unsigned long long gen = 0ull;
+        int w = 0, h = 0;
+        int quadros = 0;
+        double tNovo = 0.0, intervalo = 0.0, dur = 0.0;
+        bool temCampo = false;
+    };
+
+    void fgDesenhaAlvo(RenderTexture2D &alvo, Shader &sh, const RenderTexture2D &fonte)
+    {
+        const float aw = static_cast<float>(alvo.texture.width), ah = static_cast<float>(alvo.texture.height);
+        BeginTextureMode(alvo);
+        BeginShaderMode(sh);
+        DrawTexturePro(fonte.texture, deAlvo(fonte), Rectangle{0.0f, 0.0f, aw, ah}, Vector2{0, 0}, 0.0f, WHITE);
+        EndShaderMode();
+        EndTextureMode();
+    }
+
+    void fgTiraFiltro(RenderTexture2D &a)
+    {
+        SetTextureFilter(a.texture, TEXTURE_FILTER_POINT);
+    }
+}
+
+namespace otx_imagem
+{
+    Texture2D geraQuadro(Texture2D quadro, int w, int h, unsigned long long gen, bool &gerado)
+    {
+        gerado = false;
+        static EstadoFg e;
+        if (!e.tentado)
+        {
+            e.tentado = true;
+            e.luma = LoadShaderFromMemory(nullptr, kFgLuma);
+            e.busca = LoadShaderFromMemory(nullptr, kFgBusca);
+            e.mediana = LoadShaderFromMemory(nullptr, kFgMediana);
+            e.gera = LoadShaderFromMemory(nullptr, kFgGera);
+            e.ok = IsShaderValid(e.luma) && IsShaderValid(e.busca) && IsShaderValid(e.mediana) && IsShaderValid(e.gera);
+            std::fprintf(stderr, "[fg] frame generation %s\n", e.ok ? "ligado" : "indisponível (shader falhou)");
+            if (e.ok)
+            {
+                e.locAnt = GetShaderLocation(e.busca, "lumAnt");
+                e.locTexelB = GetShaderLocation(e.busca, "texel");
+                e.locTexelM = GetShaderLocation(e.mediana, "texel");
+                e.locQAnt = GetShaderLocation(e.gera, "quadroAnt");
+                e.locCampo = GetShaderLocation(e.gera, "campo");
+                e.locPasso = GetShaderLocation(e.gera, "passoLuma");
+                e.locAlfa = GetShaderLocation(e.gera, "alfa");
+                e.locPassoC = GetShaderLocation(e.gera, "passoCampo");
+                e.locPassoQ = GetShaderLocation(e.gera, "passoQuadro");
+                e.locSoMistura = GetShaderLocation(e.gera, "soMistura");
+            }
+        }
+        if (!e.ok || w <= 0 || h <= 0)
+            return quadro;
+        const double agora = GetTime();
+        if (w != e.w || h != e.h)
+        {
+            e.w = w;
+            e.h = h;
+            garanteAlvo(e.cur, w, h);
+            garanteAlvo(e.ant, w, h);
+            garanteAlvo(e.saida, w, h);
+            garanteAlvo(e.lumCur, 256, 224);
+            garanteAlvo(e.lumAnt, 256, 224);
+            garanteAlvo(e.campo0, 128, 112);
+            garanteAlvo(e.campo, 128, 112);
+            SetTextureFilter(e.campo.texture, TEXTURE_FILTER_POINT);
+            fgTiraFiltro(e.campo0);
+            e.quadros = 0;
+            e.temCampo = false;
+        }
+        if (gen != e.gen)
+        {
+            e.gen = gen;
+            std::swap(e.cur, e.ant);
+            std::swap(e.lumCur, e.lumAnt);
+            // cópia 1:1: o filtro do quadro não importa (mudar o do frameTex afetava a ampliação "Nenhum")
+            SetTextureFilter(e.saida.texture, modo() == Modo::Nativo ? TEXTURE_FILTER_POINT : TEXTURE_FILTER_BILINEAR);
+            BeginTextureMode(e.cur);
+            ClearBackground(BLACK);
+            DrawTexturePro(quadro, Rectangle{0.0f, 0.0f, static_cast<float>(w), static_cast<float>(h)},
+                           Rectangle{0.0f, 0.0f, static_cast<float>(w), static_cast<float>(h)}, Vector2{0, 0}, 0.0f, WHITE);
+            EndTextureMode();
+            fgDesenhaAlvo(e.lumCur, e.luma, e.cur);
+            e.intervalo = agora - e.tNovo;
+            e.tNovo = agora;
+            ++e.quadros;
+            // média curta do tempo entre quadros, sem deixar uma pausa isolada estragar a conta
+            if (e.intervalo < 0.1)
+                e.dur = e.dur > 0.0 ? e.dur * 0.8 + e.intervalo * 0.2 : e.intervalo;
+            e.temCampo = false;
+            const int hz = GetMonitorRefreshRate(GetCurrentMonitor());
+            // o intervalo de uma atualização da tela (180 Hz: 5,6 ms); com o jogo a 60 fps, gera dois quadros entre cada par
+            const double vsync = 1.0 / static_cast<double>(hz > 0 ? hz : 60);
+            const bool deveGerar = e.quadros >= 2 && e.intervalo < 0.1 && e.dur > vsync * 1.25;
+            e.temCampo = deveGerar;
+            // PS2X_FG=2: só mistura os dois quadros, sem procurar movimento
+            static const bool soMistura = [] { const char *m = std::getenv("PS2X_FG"); return m && m[0] == '2'; }();
+            if (deveGerar && !soMistura)
+            {
+                const float texelL[2] = {1.0f / 256.0f, 1.0f / 224.0f};
+                BeginTextureMode(e.campo0);
+                BeginShaderMode(e.busca);
+                SetShaderValue(e.busca, e.locTexelB, texelL, SHADER_UNIFORM_VEC2);
+                SetShaderValueTexture(e.busca, e.locAnt, e.lumAnt.texture);
+                DrawTexturePro(e.lumCur.texture, deAlvo(e.lumCur), Rectangle{0.0f, 0.0f, 128.0f, 112.0f}, Vector2{0, 0}, 0.0f, WHITE);
+                EndShaderMode();
+                EndTextureMode();
+                const float texelC[2] = {1.0f / 128.0f, 1.0f / 112.0f};
+                BeginTextureMode(e.campo);
+                BeginShaderMode(e.mediana);
+                SetShaderValue(e.mediana, e.locTexelM, texelC, SHADER_UNIFORM_VEC2);
+                DrawTexturePro(e.campo0.texture, deAlvo(e.campo0), Rectangle{0.0f, 0.0f, 128.0f, 112.0f}, Vector2{0, 0}, 0.0f, WHITE);
+                EndShaderMode();
+                EndTextureMode();
+            }
+        }
+        if (!e.temCampo)
+            return quadro;
+        const float alfa = static_cast<float>((agora - e.tNovo) / e.dur);
+        // o quadro seguinte atrasou: segura o atual em vez de extrapolar
+        if (alfa >= 0.98f)
+        {
+            BeginTextureMode(e.saida);
+            DrawTexturePro(e.cur.texture, Rectangle{0.0f, 0.0f, static_cast<float>(w), static_cast<float>(h)},
+                           Rectangle{0.0f, 0.0f, static_cast<float>(w), static_cast<float>(h)}, Vector2{0, 0}, 0.0f, WHITE);
+            EndTextureMode();
+            return e.saida.texture;
+        }
+        const float passo[2] = {1.0f / 256.0f, 1.0f / 224.0f};
+        BeginTextureMode(e.saida);
+        BeginShaderMode(e.gera);
+        SetShaderValue(e.gera, e.locAlfa, &alfa, SHADER_UNIFORM_FLOAT);
+        static const float soMisturaU = [] { const char *m = std::getenv("PS2X_FG"); return (m && m[0] == '2') ? 1.0f : 0.0f; }();
+        SetShaderValue(e.gera, e.locSoMistura, &soMisturaU, SHADER_UNIFORM_FLOAT);
+        SetShaderValue(e.gera, e.locPasso, passo, SHADER_UNIFORM_VEC2);
+        const float passoC[2] = {1.0f / 128.0f, 1.0f / 112.0f};
+        const float passoQ[2] = {1.0f / static_cast<float>(w), 1.0f / static_cast<float>(h)};
+        SetShaderValue(e.gera, e.locPassoC, passoC, SHADER_UNIFORM_VEC2);
+        SetShaderValue(e.gera, e.locPassoQ, passoQ, SHADER_UNIFORM_VEC2);
+        SetShaderValueTexture(e.gera, e.locQAnt, e.ant.texture);
+        SetShaderValueTexture(e.gera, e.locCampo, e.campo.texture);
+        DrawTexturePro(e.cur.texture, Rectangle{0.0f, 0.0f, static_cast<float>(w), static_cast<float>(h)},
+                       Rectangle{0.0f, 0.0f, static_cast<float>(w), static_cast<float>(h)}, Vector2{0, 0}, 0.0f, WHITE);
+        EndShaderMode();
+        EndTextureMode();
+        gerado = alfa > 0.02f;
+        return e.saida.texture;
+    }
+}
+
+// Claude (07/11): composição da resolução interna. O quadro do jogo tem brilho, efeitos e HUD que só existem em baixa; a passada em
+// 2x tem só a geometria. Saída = quadro ampliado (bilinear exato de 2x) + detalhe da imagem em 2x (ela menos a própria média em
+// cada pixel de baixa). Onde a passada não desenhou (palavra zero), o detalhe é zero; onde o quadro difere muito da média (HUD,
+// brilho forte), o detalhe diminui. A linha +1 vem do deslocamento de meio pixel medido entre as duas imagens.
+namespace
+{
+    const char *kCompoe2x = R"GLSL(#version 330
+uniform sampler2D texture0; // quadro do jogo
+uniform sampler2D alta;     // imagem em 2x, crua
+out vec4 finalColor;
+vec4 hi(ivec2 p) { return texelFetch(alta, ivec2(p.x, min(p.y + 1, 1023)), 0); }
+vec3 lo(ivec2 p) { return texelFetch(texture0, clamp(p, ivec2(0), ivec2(511, 447)), 0).rgb; }
+void main()
+{
+    ivec2 o = ivec2(gl_FragCoord.xy);
+    ivec2 b = o >> 1;
+    ivec2 lado = ivec2((o.x & 1) == 0 ? -1 : 1, (o.y & 1) == 0 ? -1 : 1);
+    vec3 base = (9.0 * lo(b) + 3.0 * lo(b + ivec2(lado.x, 0)) + 3.0 * lo(b + ivec2(0, lado.y)) + lo(b + lado)) / 16.0;
+    vec4 h[4] = vec4[4](hi(b * 2), hi(b * 2 + ivec2(1, 0)), hi(b * 2 + ivec2(0, 1)), hi(b * 2 + ivec2(1, 1)));
+    vec3 soma = vec3(0.0);
+    float cheios = 0.0;
+    for (int k = 0; k < 4; ++k)
+        if (h[k] != vec4(0.0))
+        {
+            soma += h[k].rgb;
+            cheios += 1.0;
+        }
+    vec4 eu = hi(o);
+    vec3 cor = base;
+    if (cheios > 0.0 && eu != vec4(0.0))
+    {
+        vec3 media = soma / cheios;
+        float dif = abs(lo(b).g - media.g) * 255.0;
+        float peso = clamp((112.0 - dif) / 64.0, 0.0, 1.0);
+        cor = clamp(base + (eu.rgb - media) * peso, 0.0, 1.0);
+    }
+    finalColor = vec4(cor, 1.0);
+}
+)GLSL";
+}
+
+namespace otx_imagem
+{
+    Texture2D compoe2x(Texture2D baixa, Texture2D alta)
+    {
+        static Shader sh{};
+        static int locAlta = -1;
+        static bool tentado = false, ok = false;
+        static RenderTexture2D saida{};
+        if (!tentado)
+        {
+            tentado = true;
+            sh = LoadShaderFromMemory(nullptr, kCompoe2x);
+            ok = IsShaderValid(sh);
+            locAlta = GetShaderLocation(sh, "alta");
+            if (!ok)
+                std::fprintf(stderr, "[gs-hi] shader da composição falhou: tela em resolução normal\n");
+        }
+        if (!ok)
+            return baixa;
+        garanteAlvo(saida, 1024, 896);
+        BeginTextureMode(saida);
+        BeginShaderMode(sh);
+        SetShaderValueTexture(sh, locAlta, alta);
+        DrawTexturePro(baixa, Rectangle{0.0f, 0.0f, 512.0f, 448.0f}, Rectangle{0.0f, 0.0f, 1024.0f, 896.0f}, Vector2{0, 0}, 0.0f, WHITE);
+        EndShaderMode();
+        EndTextureMode();
+        return saida.texture;
+    }
+}
