+#if defined(PS2X_TEM_FFX)
+    bool criaImagem(VkImageCreateInfo &ci, VkImage &img, VkDeviceMemory &mem, VkFormat fmt, uint32_t w, uint32_t h)
+    {
+        ci = VkImageCreateInfo{VK_STRUCTURE_TYPE_IMAGE_CREATE_INFO};
+        ci.imageType = VK_IMAGE_TYPE_2D;
+        ci.format = fmt;
+        ci.extent = {w, h, 1};
+        ci.mipLevels = 1;
+        ci.arrayLayers = 1;
+        ci.samples = VK_SAMPLE_COUNT_1_BIT;
+        ci.tiling = VK_IMAGE_TILING_OPTIMAL;
+        ci.usage = VK_IMAGE_USAGE_SAMPLED_BIT | VK_IMAGE_USAGE_STORAGE_BIT | VK_IMAGE_USAGE_TRANSFER_DST_BIT |
+                   VK_IMAGE_USAGE_TRANSFER_SRC_BIT;
+        ci.initialLayout = VK_IMAGE_LAYOUT_UNDEFINED;
+        if (vkCreateImage(e.dispositivo, &ci, nullptr, &img) != VK_SUCCESS)
+            return false;
+        VkMemoryRequirements req;
+        vkGetImageMemoryRequirements(e.dispositivo, img, &req);
+        VkMemoryAllocateInfo ai{VK_STRUCTURE_TYPE_MEMORY_ALLOCATE_INFO};
+        ai.allocationSize = req.size;
+        ai.memoryTypeIndex = tipoMemoria(req.memoryTypeBits, VK_MEMORY_PROPERTY_DEVICE_LOCAL_BIT);
+        if (vkAllocateMemory(e.dispositivo, &ai, nullptr, &mem) != VK_SUCCESS)
+            return false;
+        vkBindImageMemory(e.dispositivo, img, mem, 0);
+        return true;
+    }
