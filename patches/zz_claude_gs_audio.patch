+        // Claude (05/11): o relógio do EE é estimado pelo código executado e, em combate no God of War II, andava ~8,5% à
+        // frente do tempo real; o som (SPU2 e sequenciador do IOP) ia junto e a saída descartava ~100 ms a cada ~1,2 s.
+        // O IOP não passa de 20 ms à frente do tempo real nem guarda mais de 50 ms de atraso.
+        // PS2X_IOP_TEMPO_REAL=0 desliga.
+        static const bool otxTempoReal = [] { const char *e = std::getenv("PS2X_IOP_TEMPO_REAL"); return !(e && e[0] == '0'); }();
+        if (otxTempoReal)
+        {
+            constexpr int64_t kAdianto = static_cast<int64_t>(kIopClockHz / 50u), kAtraso = static_cast<int64_t>(kIopClockHz / 20u);
+            static const auto t0 = std::chrono::steady_clock::now();
+            static int64_t base = static_cast<int64_t>(m_impl->totalCycles), limite = base + kAdianto;
+            static uint32_t conta = 0u;
+            if ((conta++ & 15u) == 0u)
+            {
+                const auto us = std::chrono::duration_cast<std::chrono::microseconds>(std::chrono::steady_clock::now() - t0).count();
+                const int64_t decorrido = static_cast<int64_t>(us) * static_cast<int64_t>(kIopClockHz / 1000u) / 1000;
+                const int64_t ciclo = static_cast<int64_t>(m_impl->totalCycles);
+                if (base + decorrido > ciclo + kAtraso)
+                    base = ciclo + kAtraso - decorrido;
+                limite = base + decorrido + kAdianto;
+            }
+            if (static_cast<int64_t>(m_impl->totalCycles) >= limite)
+                return;
+        }
         if (iopCycles)
             m_impl->runCycles(iopCycles);
     }
