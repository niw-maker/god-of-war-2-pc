+            QueryPerformanceCounter(&agora);
+            QueryPerformanceFrequency(&freq);
+            if (e.tAnt.QuadPart)
+                dtMs = static_cast<float>((agora.QuadPart - e.tAnt.QuadPart) * 1000.0 / freq.QuadPart);
+            e.tAnt = agora;
