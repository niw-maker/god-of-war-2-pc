+    void destroiFontes()
+    {
+        vkDeviceWaitIdle(e.dispositivo);
+        if (e.profSrc)
+            vkDestroyImage(e.dispositivo, e.profSrc, nullptr);
+        if (e.mvSrc)
+            vkDestroyImage(e.dispositivo, e.mvSrc, nullptr);
+        if (e.profSrcMem)
+            vkFreeMemory(e.dispositivo, e.profSrcMem, nullptr);
+        if (e.mvSrcMem)
+            vkFreeMemory(e.dispositivo, e.mvSrcMem, nullptr);
+        e.profSrc = e.mvSrc = VK_NULL_HANDLE;
+        e.profSrcMem = e.mvSrcMem = VK_NULL_HANDLE;
+        for (int i = 0; i < 2; ++i)
+        {
+            if (e.envio[i])
+                vkDestroyBuffer(e.dispositivo, e.envio[i], nullptr);
+            if (e.envioMem[i])
+                vkFreeMemory(e.dispositivo, e.envioMem[i], nullptr);
+            e.envio[i] = VK_NULL_HANDLE;
+            e.envioMem[i] = VK_NULL_HANDLE;
+            e.envioPtr[i] = nullptr;
+        }
+        e.srcW = e.srcH = 0;
+    }
