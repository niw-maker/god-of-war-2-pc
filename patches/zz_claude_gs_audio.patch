+    // copia a imagem do framebuffer padrão do GL (w x h) para a imagem compartilhada e a mostra na janela
+    bool apresenta(int w, int h, const Quadro *qd)
+    {
+        if (!e.ok || w <= 0 || h <= 0)
+            return false;
+#if defined(PS2X_TEM_FFX)
+        // com a geração de quadros, quadro repetido não vai para o FSR (ele interpolaria entre duas imagens iguais)
+        if (e.fg && qd && !qd->novo)
+            return true;
+#endif
+        if (e.compW != static_cast<uint32_t>(w) || e.compH != static_cast<uint32_t>(h))
+            if (!criaCompartilhada(static_cast<uint32_t>(w), static_cast<uint32_t>(h)))
+            {
+                log("imagem compartilhada falhou");
+                e.ok = false;
+                return false;
+            }
+        {
+            RECT rc, rf;
+            GetClientRect(e.janela, &rc);
+            GetClientRect(e.filha, &rf);
+            if (rc.right != rf.right || rc.bottom != rf.bottom)
+            {
+                SetWindowPos(e.filha, nullptr, 0, 0, rc.right, rc.bottom, SWP_NOZORDER | SWP_NOACTIVATE);
+                refazTroca(static_cast<uint32_t>(rc.right), static_cast<uint32_t>(rc.bottom));
+            }
+        }
+        const uint32_t q = e.quadro & 1u;
+        LARGE_INTEGER m0, m1, mf;
+        QueryPerformanceFrequency(&mf);
+        QueryPerformanceCounter(&m0);
+        auto ms = [&](LARGE_INTEGER a, LARGE_INTEGER b) { return (b.QuadPart - a.QuadPart) * 1000.0 / mf.QuadPart; };
+        LARGE_INTEGER mIni = m0;
+        vkWaitForFences(e.dispositivo, 1, &e.cerca[q], VK_TRUE, UINT64_MAX);
+        QueryPerformanceCounter(&m1);
+        e.msCerca += ms(m0, m1);
+        // o GL só escreve na imagem depois que o Vulkan terminou de copiá-la
+        const GLenum layoutCor = GL_LAYOUT_COLOR_ATTACHMENT_EXT;
+        if (e.vkEmVoo)
+            gl.waitSemaphore(e.glSemVk, 0, nullptr, 1, &e.glTex, &layoutCor);
+        GLint lido = 0, desenho = 0;
+        gl.getIntegerv(GL_READ_FRAMEBUFFER_BINDING, &lido);
+        gl.getIntegerv(GL_DRAW_FRAMEBUFFER_BINDING, &desenho);
+        gl.bindFramebuffer(GL_READ_FRAMEBUFFER, 0);
+        gl.bindFramebuffer(GL_DRAW_FRAMEBUFFER, e.glFbo);
