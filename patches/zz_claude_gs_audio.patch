+namespace otx_vk
+{
+    bool inicia(void *hwnd)
+    {
+        e.janela = static_cast<HWND>(hwnd);
+        bool okGl = true;
+        okGl &= carregaGl(gl.createMemoryObjects, "glCreateMemoryObjectsEXT");
+        okGl &= carregaGl(gl.memoryObjectParameteriv, "glMemoryObjectParameterivEXT");
+        okGl &= carregaGl(gl.importMemoryWin32Handle, "glImportMemoryWin32HandleEXT");
+        okGl &= carregaGl(gl.texStorageMem2D, "glTexStorageMem2DEXT");
+        okGl &= carregaGl(gl.genSemaphores, "glGenSemaphoresEXT");
+        okGl &= carregaGl(gl.importSemaphoreWin32Handle, "glImportSemaphoreWin32HandleEXT");
+        okGl &= carregaGl(gl.signalSemaphore, "glSignalSemaphoreEXT");
+        okGl &= carregaGl(gl.waitSemaphore, "glWaitSemaphoreEXT");
+        okGl &= carregaGl(gl.getUnsignedBytev, "glGetUnsignedBytevEXT");
+        carregaGl(gl.getUnsignedBytei_v, "glGetUnsignedBytei_vEXT");
+        okGl &= carregaGl(gl.genTextures, "glGenTextures");
+        okGl &= carregaGl(gl.deleteTextures, "glDeleteTextures");
+        okGl &= carregaGl(gl.bindTexture, "glBindTexture");
+        okGl &= carregaGl(gl.texParameteri, "glTexParameteri");
+        okGl &= carregaGl(gl.genFramebuffers, "glGenFramebuffers");
+        okGl &= carregaGl(gl.deleteFramebuffers, "glDeleteFramebuffers");
+        okGl &= carregaGl(gl.bindFramebuffer, "glBindFramebuffer");
+        okGl &= carregaGl(gl.framebufferTexture2D, "glFramebufferTexture2D");
+        okGl &= carregaGl(gl.blitFramebuffer, "glBlitFramebuffer");
+        okGl &= carregaGl(gl.flush, "glFlush");
+        okGl &= carregaGl(gl.getIntegerv, "glGetIntegerv");
+        if (!okGl)
+        {
+            log("o OpenGL desta placa não tem as extensões de memória compartilhada; seguindo só com OpenGL");
+            return false;
+        }
+        GLubyte uuidGl[16] = {};
+        gl.getUnsignedBytev(GL_DEVICE_UUID_EXT, uuidGl);
+        if (gl.getUnsignedBytei_v)
+        {
+            GLint nU = 0;
+            gl.getIntegerv(GL_NUM_DEVICE_UUIDS_EXT, &nU);
+            if (nU > 0)
+                gl.getUnsignedBytei_v(GL_DEVICE_UUID_EXT, 0, uuidGl);
+        }
+
+        VkApplicationInfo app{VK_STRUCTURE_TYPE_APPLICATION_INFO};
+        app.pApplicationName = "God of War II";
+        app.apiVersion = VK_API_VERSION_1_3;
+        const char *extInst[] = {VK_KHR_SURFACE_EXTENSION_NAME, VK_KHR_WIN32_SURFACE_EXTENSION_NAME,
+                                 VK_KHR_GET_PHYSICAL_DEVICE_PROPERTIES_2_EXTENSION_NAME};
+        VkInstanceCreateInfo ii{VK_STRUCTURE_TYPE_INSTANCE_CREATE_INFO};
+        ii.pApplicationInfo = &app;
+        ii.enabledExtensionCount = 3;
+        ii.ppEnabledExtensionNames = extInst;
+        if (vkCreateInstance(&ii, nullptr, &e.instancia) != VK_SUCCESS)
+        {
+            log("vkCreateInstance falhou");
+            return false;
+        }
+        uint32_t n = 0;
+        vkEnumeratePhysicalDevices(e.instancia, &n, nullptr);
+        std::vector<VkPhysicalDevice> fis(n);
+        vkEnumeratePhysicalDevices(e.instancia, &n, fis.data());
+        for (VkPhysicalDevice f : fis)
+        {
+            VkPhysicalDeviceIDProperties idp{VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_ID_PROPERTIES};
+            VkPhysicalDeviceProperties2 p2{VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_PROPERTIES_2};
+            p2.pNext = &idp;
+            vkGetPhysicalDeviceProperties2(f, &p2);
+            if (std::memcmp(idp.deviceUUID, uuidGl, 16) == 0)
+            {
+                e.fisico = f;
+                std::fprintf(stderr, "[vulkan] placa: %s\n", p2.properties.deviceName);
+            }
+        }
+        if (!e.fisico)
+        {
+            log("nenhuma placa Vulkan é a mesma do OpenGL");
+            return false;
+        }
+        {
+            // filha desativada: teclado e mouse continuam na janela do jogo
+            WNDCLASSA wc{};
+            wc.lpfnWndProc = DefWindowProcA;
+            wc.hInstance = GetModuleHandleA(nullptr);
+            wc.lpszClassName = "OtxVulkanFilha";
+            RegisterClassA(&wc);
+            RECT rc;
+            GetClientRect(e.janela, &rc);
+            e.filha = CreateWindowExA(0, "OtxVulkanFilha", "", WS_CHILD | WS_VISIBLE | WS_DISABLED | WS_CLIPSIBLINGS, 0, 0,
+                                      rc.right - rc.left, rc.bottom - rc.top, e.janela, nullptr, wc.hInstance, nullptr);
+            if (!e.filha)
+            {
+                log("a janela-filha não abriu");
+                return false;
+            }
+        }
+        VkWin32SurfaceCreateInfoKHR si{VK_STRUCTURE_TYPE_WIN32_SURFACE_CREATE_INFO_KHR};
+        si.hinstance = GetModuleHandleA(nullptr);
+        si.hwnd = e.filha;
+        if (vkCreateWin32SurfaceKHR(e.instancia, &si, nullptr, &e.superficie) != VK_SUCCESS)
+        {
+            log("vkCreateWin32SurfaceKHR falhou");
+            return false;
+        }
+        vkGetPhysicalDeviceQueueFamilyProperties(e.fisico, &n, nullptr);
+        std::vector<VkQueueFamilyProperties> qf(n);
+        vkGetPhysicalDeviceQueueFamilyProperties(e.fisico, &n, qf.data());
+        bool achou = false;
+        for (uint32_t i = 0; i < n && !achou; ++i)
+        {
+            VkBool32 apresenta = VK_FALSE;
+            vkGetPhysicalDeviceSurfaceSupportKHR(e.fisico, i, e.superficie, &apresenta);
+            if ((qf[i].queueFlags & VK_QUEUE_GRAPHICS_BIT) && (qf[i].queueFlags & VK_QUEUE_COMPUTE_BIT) && apresenta)
+            {
+                e.familia = i;
+                achou = true;
+            }
+        }
+        if (!achou)
+        {
+            log("sem fila gráfica que apresente na janela");
+            return false;
+        }
+        // filas: 0 = jogo; 1 = apresentação do FSR; 2 = aquisição de imagem; cálculo assíncrono numa família só de cálculo
+        // quando houver (cada papel em uma fila, pois o FSR apresenta de outra thread)
+        const uint32_t nGraf = std::min(qf[e.familia].queueCount, 3u);
+        int famCalc = -1;
+        for (uint32_t i = 0; i < n; ++i)
+            if (i != e.familia && (qf[i].queueFlags & VK_QUEUE_COMPUTE_BIT) && !(qf[i].queueFlags & VK_QUEUE_GRAPHICS_BIT))
+            {
+                famCalc = static_cast<int>(i);
+                break;
+            }
+        const float prio[3] = {1.0f, 1.0f, 1.0f};
+        VkDeviceQueueCreateInfo qi[2]{};
+        qi[0].sType = qi[1].sType = VK_STRUCTURE_TYPE_DEVICE_QUEUE_CREATE_INFO;
+        qi[0].queueFamilyIndex = e.familia;
+        qi[0].queueCount = nGraf;
+        qi[0].pQueuePriorities = prio;
+        qi[1].queueFamilyIndex = famCalc >= 0 ? static_cast<uint32_t>(famCalc) : 0u;
+        qi[1].queueCount = 1;
+        qi[1].pQueuePriorities = prio;
+        // extensões: as do compartilhamento com o GL e as que o FSR usa, quando a placa tiver
+        uint32_t nExt = 0;
+        vkEnumerateDeviceExtensionProperties(e.fisico, nullptr, &nExt, nullptr);
+        std::vector<VkExtensionProperties> exts(nExt);
+        vkEnumerateDeviceExtensionProperties(e.fisico, nullptr, &nExt, exts.data());
+        auto tem = [&](const char *nome)
+        {
+            for (auto &x : exts)
+                if (std::strcmp(x.extensionName, nome) == 0)
+                    return true;
+            return false;
+        };
+        std::vector<const char *> extDev{VK_KHR_SWAPCHAIN_EXTENSION_NAME, VK_KHR_EXTERNAL_MEMORY_WIN32_EXTENSION_NAME,
+                                         VK_KHR_EXTERNAL_SEMAPHORE_WIN32_EXTENSION_NAME};
+        for (const char *x : {"VK_KHR_synchronization2", "VK_EXT_subgroup_size_control", "VK_KHR_shader_float16_int8",
+                              "VK_EXT_descriptor_indexing", "VK_KHR_dedicated_allocation", "VK_KHR_get_memory_requirements2",
+                              "VK_KHR_16bit_storage", "VK_KHR_storage_buffer_storage_class"})
+            if (tem(x))
+                extDev.push_back(x);
+        // todos os recursos que a placa suporta (o FSR precisa de float16, subgrupos, sincronização 2...)
+        VkPhysicalDeviceVulkan13Features f13{VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_VULKAN_1_3_FEATURES};
+        VkPhysicalDeviceVulkan12Features f12{VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_VULKAN_1_2_FEATURES};
+        VkPhysicalDeviceVulkan11Features f11{VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_VULKAN_1_1_FEATURES};
+        VkPhysicalDeviceFeatures2 f2{VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_FEATURES_2};
+        f2.pNext = &f11;
+        f11.pNext = &f12;
+        f12.pNext = &f13;
+        vkGetPhysicalDeviceFeatures2(e.fisico, &f2);
+        f2.features.robustBufferAccess = VK_FALSE;
+        f13.robustImageAccess = VK_FALSE;
+        VkDeviceCreateInfo di{VK_STRUCTURE_TYPE_DEVICE_CREATE_INFO};
+        di.pNext = &f2;
+        di.queueCreateInfoCount = famCalc >= 0 ? 2u : 1u;
+        di.pQueueCreateInfos = qi;
+        di.enabledExtensionCount = static_cast<uint32_t>(extDev.size());
+        di.ppEnabledExtensionNames = extDev.data();
+        if (vkCreateDevice(e.fisico, &di, nullptr, &e.dispositivo) != VK_SUCCESS)
+        {
+            log("vkCreateDevice falhou");
+            return false;
+        }
+        vkGetDeviceQueue(e.dispositivo, e.familia, 0, &e.fila);
+        vkGetDeviceQueue(e.dispositivo, e.familia, std::min(1u, nGraf - 1u), &e.filaApres);
+        vkGetDeviceQueue(e.dispositivo, e.familia, std::min(2u, nGraf - 1u), &e.filaAdq);
+        if (famCalc >= 0)
+        {
+            e.familiaAsync = static_cast<uint32_t>(famCalc);
+            vkGetDeviceQueue(e.dispositivo, e.familiaAsync, 0, &e.filaAsync);
+        }
+        else
+        {
+            e.familiaAsync = e.familia;
+            e.filaAsync = e.filaAdq;
+        }
+        std::fprintf(stderr, "[vulkan] filas: %u gráficas, cálculo %s\n", nGraf, famCalc >= 0 ? "separado" : "dividido");
+        e.getMemHandle = reinterpret_cast<PFN_vkGetMemoryWin32HandleKHR>(vkGetDeviceProcAddr(e.dispositivo, "vkGetMemoryWin32HandleKHR"));
+        e.getSemHandle = reinterpret_cast<PFN_vkGetSemaphoreWin32HandleKHR>(vkGetDeviceProcAddr(e.dispositivo, "vkGetSemaphoreWin32HandleKHR"));
+        if (!e.getMemHandle || !e.getSemHandle)
+        {
+            log("sem as funções de exportação para o OpenGL");
+            return false;
+        }
+        VkCommandPoolCreateInfo pi{VK_STRUCTURE_TYPE_COMMAND_POOL_CREATE_INFO};
+        pi.flags = VK_COMMAND_POOL_CREATE_RESET_COMMAND_BUFFER_BIT;
+        pi.queueFamilyIndex = e.familia;
+        vkCreateCommandPool(e.dispositivo, &pi, nullptr, &e.pool);
+        VkCommandBufferAllocateInfo cai{VK_STRUCTURE_TYPE_COMMAND_BUFFER_ALLOCATE_INFO};
+        cai.commandPool = e.pool;
+        cai.level = VK_COMMAND_BUFFER_LEVEL_PRIMARY;
+        cai.commandBufferCount = 2;
+        vkAllocateCommandBuffers(e.dispositivo, &cai, e.cmd);
+        for (int i = 0; i < 2; ++i)
+        {
+            VkFenceCreateInfo fi{VK_STRUCTURE_TYPE_FENCE_CREATE_INFO};
+            fi.flags = VK_FENCE_CREATE_SIGNALED_BIT;
+            vkCreateFence(e.dispositivo, &fi, nullptr, &e.cerca[i]);
+            VkSemaphoreCreateInfo sci{VK_STRUCTURE_TYPE_SEMAPHORE_CREATE_INFO};
+            vkCreateSemaphore(e.dispositivo, &sci, nullptr, &e.adquirida[i]);
+            vkCreateSemaphore(e.dispositivo, &sci, nullptr, &e.pronta[i]);
+        }
+        if (!criaSemaforoExportado(e.glPronto, e.glSemGl) || !criaSemaforoExportado(e.vkPronto, e.glSemVk))
+        {
+            log("semáforos compartilhados falharam");
+            return false;
+        }
+        RECT r;
+        GetClientRect(e.filha, &r);
+        if (!criaTroca(static_cast<uint32_t>(r.right - r.left), static_cast<uint32_t>(r.bottom - r.top)))
+        {
+            log("swapchain falhou");
+            return false;
+        }
+        e.ok = true;
+        log("apresentação pelo Vulkan ligada");
+        // Claude (08/11): a thread da janela entrega os quadros ao FSR; com o jogo sem a espera do FINISH (EE e GS a todo
+        // vapor) ela perdia a vez no processador e atrasava a entrega (PS2X_JANELA_PRIORIDADE=0 desliga)
+        {
+            const char *pr = std::getenv("PS2X_JANELA_PRIORIDADE");
+            if (!(pr && pr[0] == '0'))
+                SetThreadPriority(GetCurrentThread(), THREAD_PRIORITY_ABOVE_NORMAL);
+        }
+#if defined(PS2X_TEM_FFX)
+        {
+            const char *fg = std::getenv("PS2X_FSR_FG");
+            if (fg && fg[0] == '1')
+            {
+                const char *dbg = std::getenv("PS2X_FSR_FG_DEBUG");
+                if (dbg && dbg[0] == '1')
+                    e.flagsDebug = FFX_FRAMEGENERATION_FLAG_DRAW_DEBUG_TEAR_LINES | FFX_FRAMEGENERATION_FLAG_DRAW_DEBUG_RESET_INDICATORS;
+                else if (dbg && dbg[0] == '2')
+                    e.flagsDebug = FFX_FRAMEGENERATION_FLAG_DRAW_DEBUG_VIEW;
+                e.fg = ligaFfx();
+                if (!e.fg)
+                {
+                    desligaFfx();
+                    RECT r2;
+                    GetClientRect(e.filha, &r2);
+                    if (!e.troca && !criaTroca(static_cast<uint32_t>(r2.right - r2.left), static_cast<uint32_t>(r2.bottom - r2.top)))
+                    {
+                        e.ok = false;
+                        return false;
+                    }
+                }
+                else
+                    log("geração de quadros do FSR 3.1 ligada");
+            }
+        }
+#endif
+        return true;
+    }
+
+    bool ativo() { return e.ok; }
+
+    bool fsrFg()
+    {
